<Window
    x:Class="GunWall.AlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Network alert - GunWall"
    Width="386" SizeToContent="Height"
    WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
    ShowInTaskbar="False" Topmost="True"
    WindowStartupLocation="Manual"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- ============================================================
         Connection prompt.

         This window interrupts someone mid-task to ask a question they
         did not invite, so every choice is about taking as little as
         possible: a small corner radius rather than a soft pill, one
         quiet shadow, and two lines of body text - which application,
         and where it is going. Everything else waits behind Details.

         The two action buttons are deliberately the same colour. A
         bright green Allow beside a red Block turns a decision into a
         reflex, and the reflex people learn is to click the coloured
         one. The labels carry the meaning, the icons separate them at
         a glance, and dismissing the window blocks anyway.
         ============================================================ -->

    <Border Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="0.30" Color="#000000" />
        </Border.Effect>

        <Grid Margin="18,16,18,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- badge: ringed pin with a NEW tab -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                  Width="54" Height="58" VerticalAlignment="Top" Margin="0,2,14,0">
                <Path Fill="{DynamicResource BgCard}"
                      Stroke="{DynamicResource BorderBrush}" StrokeThickness="2.5"
                      Stretch="Uniform" Width="46" Height="52"
                      VerticalAlignment="Top" HorizontalAlignment="Center"
                      Data="M 24,2 C 36,2 46,12 46,24 C 46,36 30,48 24,54 C 18,48 2,36 2,24 C 2,12 12,2 24,2 Z" />
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="19" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0" />
                <Border Background="{DynamicResource AllowText}" CornerRadius="8"
                        Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="-2,0,0,2">
                    <TextBlock Text="NEW" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>
            </Grid>

            <!-- title -->
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock x:Name="HeaderText" Text="First Network Access"
                           FontSize="17.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="SummaryText" Text="Outgoing Connection"
                           FontSize="11.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <Button Grid.Row="0" Grid.Column="2" Content="&#xE711;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                    Width="22" Height="22" Padding="0" BorderThickness="0"
                    Background="Transparent" Foreground="{DynamicResource TextTertiary}"
                    VerticalAlignment="Top" Cursor="Hand" Click="Close_Click"
                    ToolTip="Dismiss. The application stays blocked." />

            <!-- which application -->
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Margin="0,13,0,0">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="NameText" Text="app.exe" FontSize="12.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="196" Foreground="{DynamicResource InfoText}" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SignatureText" Text="Info" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" />
                </Border>
            </StackPanel>

            <!-- where it is going -->
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Margin="0,7,0,0">
                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="HostText" Text="Resolving..." FontSize="12.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="272" Foreground="{DynamicResource InfoText}" />
            </StackPanel>

            <!-- everything else, folded away -->
            <Border x:Name="DetailsPanel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Visibility="Collapsed" Margin="0,13,0,0"
                    Background="{DynamicResource BgElevated}" CornerRadius="5" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Address" FontSize="11"
                               Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AddressText" Text="&#x2014;"
                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" FontSize="11"
                               Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PortText" Text="&#x2014;"
                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Path" FontSize="11"
                               Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PathText" Text="&#x2014;"
                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Time" FontSize="11"
                               Foreground="{DynamicResource TextTertiary}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DateText" Text="&#x2014;"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                </Grid>
            </Border>

            <!-- actions -->
            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="AllowButton" Style="{StaticResource PromptButton}"
                            Width="104" Margin="0,0,8,0" Click="Allow_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Allow" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BlockButton" Style="{StaticResource PromptButton}"
                            Width="104" Margin="0,0,8,0" Click="Block_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Block" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DetailsButton" Style="{StaticResource PromptButton}"
                            Width="34" Click="Details_Click"
                            ToolTip="Show everything known about this connection.">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="DetailsChevron" Text="&#xE70D;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="DetailsLabel" Text="" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="CountdownHint" FontSize="10.5"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" Margin="0,9,0,0" Text="" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
