<Window
    x:Class="GunWall.AlertWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Network alert - GunWall"
    Width="430" SizeToContent="Height"
    WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
    ShowInTaskbar="False" Topmost="True"
    WindowStartupLocation="Manual"
    Typography.NumeralAlignment="Tabular"
    FontFamily="{DynamicResource UiFont}"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- ============================================================
         Connection prompt.

         This interrupts someone mid-task to ask a question they did
         not invite, so it asks for as little screen and as little
         attention as it can: one question, the app, where it is
         going, two buttons. Everything else is behind the chevron.

         0.99.44 tried the opposite - the design's 580px dialog with
         every fact laid out - on the reasoning that a security
         question answered from a summary is answered badly. That
         reasoning was sound and the result was still wrong: a modal
         that large, arriving unannounced over whatever you were
         doing, is not read more carefully, it is dismissed faster.
         Back to compact, with the detail one press away rather than
         absent.

         It stays a separate always-on-top window rather than an
         in-window overlay: GunWall lives in the tray, and a prompt
         has to be answerable when the main window is hidden.

         Machine values are JetBrains Mono, prose is Instrument Sans.
         ============================================================ -->

    <Border Background="{DynamicResource BgElevated}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270"
                              Opacity="0.40" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- State strip. What kind of moment this is, then the countdown in
                 mono so a number changing every second cannot shove the text
                 beside it around. -->
            <Border Padding="16,12" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Divider}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0"
                                 Fill="{DynamicResource WarnText}" />
                        <TextBlock x:Name="HeaderText" Text="FIRST CONNECTION"
                                   FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarnText}" />
                    </StackPanel>
                    <TextBlock x:Name="CountdownHint" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="10.5"
                               FontFamily="{StaticResource MonoFont}"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"
                               Foreground="{DynamicResource TextTertiary}" />
                </Grid>
            </Border>

            <StackPanel Margin="16,15,16,15">
                <!-- The question, then the two facts needed to answer it. -->
                <TextBlock x:Name="SummaryText" Text="An app wants to connect out"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}" />

                <Grid Margin="0,11,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="NameText" Text="app.exe" FontSize="12.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                Background="{DynamicResource InfoFill}" VerticalAlignment="Center">
                            <TextBlock x:Name="SignatureText" Text="Checking..." FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="AddressText" Text="&#x2014;" FontSize="12" Margin="0,7,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}" />

                <!-- Detail, collapsed. Everything a decision might need that the
                     two lines above do not carry. -->
                <Border x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,12,0,0"
                        CornerRadius="8" Padding="12,4"
                        Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,7">
                            <TextBlock Text="Port" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <TextBlock x:Name="PortText" Text="&#x2014;" FontSize="11.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </Grid>
                        <Grid Margin="0,7">
                            <TextBlock Text="Reverse DNS" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <TextBlock x:Name="HostText" Text="Resolving..." FontSize="11.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                       MaxWidth="240"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                        <Grid Margin="0,7">
                            <TextBlock Text="Time" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <TextBlock x:Name="DateText" Text="&#x2014;" FontSize="11.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                        <Grid Margin="0,7">
                            <TextBlock Text="Path" FontSize="11.5" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <TextBlock x:Name="PathText" Text="&#x2014;" FontSize="11"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Right" TextWrapping="Wrap"
                                       MaxWidth="290" TextAlignment="Right"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions. The chevron is a real 30x30 button this time, sized
                     from its own padding rather than inheriting thirty pixels of
                     it from a shared style and clipping the glyph to a dot. -->
                <Grid Margin="0,14,0,0">
                    <Button x:Name="DetailsButton" HorizontalAlignment="Left"
                            Style="{StaticResource PromptChevron}" Click="Details_Click"
                            ToolTip="Show everything known about this connection.">
                        <Path x:Name="DetailsChevron" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="2.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Fill="{x:Null}"
                              Data="{StaticResource IconChevronDown}" />
                    </Button>
                    <TextBlock x:Name="DetailsLabel" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BlockButton" Content="Block" Click="Block_Click"
                                Style="{StaticResource PromptSecondary}" Margin="0,0,8,0" />
                        <Button x:Name="AllowButton" Content="Allow" Click="Allow_Click"
                                Style="{StaticResource PromptPrimary}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
