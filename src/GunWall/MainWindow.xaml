                                        Click="PortalMode_Click" Padding="14,8" />
                            </StackPanel>
                            <TextBlock x:Name="PortalStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RULE PROFILES" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Save your current per-app allow/block rules as a named profile (e.g. Gaming, Work) and switch between them in one click. Apps not captured in a profile are left untouched; muted apps keep their setting."
                                       Style="{StaticResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ProfileCombo" Width="200" Margin="0,0,8,0" />
                                <Button x:Name="ProfileApplyBtn" Content="Apply profile" Style="{StaticResource PrimaryButton}"
                                        Click="ProfileApply_Click" Padding="14,8" Margin="0,0,24,0" />
                                <TextBox x:Name="ProfileNameBox" Width="170" MinHeight="33" VerticalContentAlignment="Center"
                                         Margin="0,0,8,0" ToolTip="Name for the new profile (e.g. Gaming)" />
                                <Button x:Name="ProfileSaveBtn" Content="Save current as" Style="{StaticResource ActionButton}"
                                        Click="ProfileSave_Click" Padding="14,8" />
                            </StackPanel>
                            <TextBlock x:Name="RuleProfileStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PROFILES" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Save the current rules and settings as a named profile, then switch between profiles (e.g. Home, Work, Travel)."
                                       Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox x:Name="ProfilesCombo" Width="200" Margin="0,0,8,0" />
                                <Button Content="Load" Style="{StaticResource ActionButton}"
                                        Click="LoadProfile_Click" Margin="0,0,8,0" />
                                <Button Content="Delete" Style="{StaticResource ActionButton}"
                                        Click="DeleteProfile_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="NewProfileName" Width="200" MinHeight="33"
                                         VerticalContentAlignment="Center" Margin="0,0,8,0"
                                         ToolTip="New profile name" />
                                <Button Content="Save current as profile" Style="{StaticResource PrimaryButton}"
                                        Click="SaveProfile_Click" Padding="14,7" />
                            </StackPanel>
                            <TextBlock x:Name="ProfileStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" Text="" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BACKUPS" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Versioned snapshots of your rules and settings. Restore points let you roll back if a change goes wrong. The newest 15 are kept."
                                       Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <CheckBox x:Name="AutoBackupCheck" Content="Automatically back up on each launch"
                                      Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"
                                      Checked="Pref_Changed" Unchecked="Pref_Changed" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox x:Name="BackupsCombo" Width="240" Margin="0,0,8,0" />
                                <Button Content="Restore" Style="{StaticResource ActionButton}"
                                        Click="RestoreBackup_Click" Margin="0,0,8,0" />
                                <Button Content="Back up now" Style="{StaticResource ActionButton}"
                                        Click="BackupNow_Click" />
                            </StackPanel>
                            <TextBlock x:Name="BackupStatus" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="VIRUSTOTAL" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Add your VirusTotal API key and GunWall automatically checks each app's file hash in the background, showing the verdict in the Apps list (right-click an app for an on-demand scan). Only the file hash is sent, never the file. Results are cached; the free tier is checked at a rate-limit-safe pace."
                                       Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <PasswordBox x:Name="VtApiKeyBox" Width="280" Padding="8,6"
                                             Background="{DynamicResource BgElevated}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,8,0" />
                                <Button Content="Save key" Style="{StaticResource ActionButton}"
                                        Click="SaveVtKey_Click" />
                            </StackPanel>
                            <TextBlock x:Name="VtKeyStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" Text="" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="REFRESH INTERVAL" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="How often connections and the graph update. Slower = lower CPU."
                                       Style="{StaticResource Muted}" Margin="0,2,0,10" />
                            <ComboBox x:Name="IntervalCombo" Width="160" HorizontalAlignment="Left"
                                      SelectionChanged="IntervalCombo_Changed">
                                <ComboBoxItem Content="1 second" IsSelected="True" Tag="1000" />
                                <ComboBoxItem Content="2 seconds" Tag="2000" />
                                <ComboBoxItem Content="5 seconds" Tag="5000" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RESET FIREWALL" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Removes every filter GunWall has created (including persistent ones) and clears saved rules. Run this before uninstalling."
                                       Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <Button Content="Remove all GunWall filtering"
                                    Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                    Click="RemoveAll_Click" />

                            <!-- Deliberately the SECOND thing here, and deliberately
                                 described as keeping the rules. The two are easy to
                                 confuse and only one of them is destructive to the
                                 ruleset, so the wording has to carry that difference
                                 rather than the button label alone. -->
                            <TextBlock Text="RESET SETTINGS" Style="{StaticResource SectionLabel}"
                                       Margin="0,22,0,0" />
                            <TextBlock Text="Puts every preference back to its default - theme, colours, font, interface scale, alert categories, popup timeout, logging and DNS options. Your application rules, custom rules and blocklists are kept, and filtering is not touched."
                                       Style="{StaticResource Muted}" Margin="0,2,0,10" TextWrapping="Wrap" />
                            <Button Content="Reset settings to defaults"
                                    Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                    Click="ResetSettings_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       x:Name="AboutText"
                                       Text="GunWall - free, open-source, no telemetry. Built on the Windows Filtering Platform." />
                            <TextBlock Margin="0,6,0,0">
                                <Hyperlink NavigateUri="https://github.com/ox1d3x3/gunwall"
                                           RequestNavigate="Repo_RequestNavigate"
                                           Style="{StaticResource RepoLink}">github.com/ox1d3x3/gunwall</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
        </Grid>

        <!-- The persistent footer was removed in 0.99.43. Three of its five
             readouts had become duplicates once the posture module and top bar
             landed: protection state was in both of those, the rates were in the
             top bar, and the alert count was already the nav badge.

             Its two genuinely unique readouts were rehomed rather than dropped.
             Session totals are tooltips on the top bar rates - the rate is what
             you glance at, the total is what you go looking for. Metering mode is
             now a banner on Traffic, shown only when metering is estimated rather
             than ETW-measured, which is the screen where that caveat changes how
             you read a number. A permanent label on every screen was noise; a
             banner where the number is being read is signal. -->

        <!-- ================= Command palette, section 15 =================
             620 wide, centred, over a scrim. Replaces the 300px dropdown that
             hung under the top bar field: that could list destinations and
             nothing else, and the actions people actually want at speed - turn
             the firewall on, engage lockdown - had no home in it.

             Sits last in RootGrid and spans both columns so the scrim covers
             the sidebar too. A palette that dimmed the content but left the nav
             lit would look like a dialog belonging to one panel. -->
        <Grid x:Name="Palette" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="90">
            <Rectangle Fill="{DynamicResource Scrim}" MouseLeftButtonUp="PaletteScrim_Click" />
            <Border Width="620" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,130,0,0" CornerRadius="14"
                    Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="20" Direction="270"
                                      Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Border Padding="18,16" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Divider}">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" Fill="{x:Null}"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{DynamicResource IconSearch}" />
                            <TextBox x:Name="PaletteInput" Margin="28,0,44,0" FontSize="15"
                                     Style="{StaticResource SearchField}"
                                     TextChanged="PaletteInput_TextChanged"
                                     PreviewKeyDown="PaletteInput_PreviewKeyDown" />
                            <TextBlock x:Name="PaletteHint" Text="Type a command or search..."
                                       Margin="28,0,0,0" FontSize="15" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="4" Padding="6,3" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                <TextBlock Text="ESC" FontSize="10.5"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ListBox x:Name="PaletteList" MaxHeight="420" BorderThickness="0"
                             Margin="8,10,8,12" Background="Transparent"
                             ItemContainerStyle="{StaticResource SearchResultRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseLeftButtonUp="PaletteList_Click">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="10"
                                                   FontWeight="SemiBold" Margin="12,10,12,6"
                                                   Foreground="{DynamicResource TextTertiary}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <TextBlock Text="{Binding Label}" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
