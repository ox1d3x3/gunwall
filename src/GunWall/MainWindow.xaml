                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,9,0"
                                 Fill="{DynamicResource WarnText}" />
                        <TextBlock Text="Estimated metering — per-app byte counts are derived, not measured. Live ETW metering is unavailable in this session."
                                   FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Traffic" Style="{StaticResource H1}" />
                        <TextBlock x:Name="TrafficSubtitle"
                                   Text="Where your traffic has gone since GunWall started."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CONNECTION MAP" Style="{StaticResource Muted}"
                                   FontSize="11" FontWeight="SemiBold" Margin="2,0,0,10" />
                        <Viewbox Stretch="Uniform" MaxHeight="320" HorizontalAlignment="Stretch">
                            <Grid Width="1000" Height="500">
                                <!-- StrokeThickness 1.1, not 0.4. The Grid is 1000x500
                                     inside a Viewbox capped at 320px tall, so everything
                                     here is scaled to roughly 0.64x: a 0.4 stroke landed
                                     at a quarter of a pixel and simply did not draw on
                                     most displays. The coastline is what makes a
                                     landmass readable at this size, so it has to survive
                                     the scale rather than be chosen at design size. -->
                                <Path Data="{Binding Source={x:Static svc:WorldMapData.LandPathData}}"
                                      Fill="{DynamicResource MapLand}" Stroke="{DynamicResource MapBorder}"
                                      StrokeThickness="1.5" />
                                <Canvas x:Name="MapMarkers" Width="1000" Height="500" />
                            </Grid>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="0" Margin="0,0,18,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="TOP COUNTRIES" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <ListView x:Name="TrafficCountries" Height="190" gw:Table.EmptyTitle="No traffic by country yet" gw:Table.EmptyText="Destinations are grouped here once GeoIP can place them." BorderThickness="0" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="COUNTRY" Width="240">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Width="22" Height="15" Margin="0,0,9,0"
                                                               VerticalAlignment="Center"
                                                               Stretch="Uniform" SnapsToDevicePixels="True"
                                                               Source="{Binding Code, Converter={StaticResource CountryFlag}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="DESTINATIONS" Width="120" DisplayMemberBinding="{Binding Count}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="0" Margin="18,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="MOST ACTIVE APPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <ListView x:Name="TrafficApps" Height="190" gw:Table.EmptyTitle="No per-app traffic yet" gw:Table.EmptyText="Byte counts appear once applications start moving data." BorderThickness="0" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="APPLICATION" Width="210" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="DESTINATIONS" Width="124" DisplayMemberBinding="{Binding Count}" />
                                        <GridViewColumn Header="COUNTRIES" Width="100" DisplayMemberBinding="{Binding Countries}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="DATA USAGE BY APP" Style="{StaticResource Muted}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
