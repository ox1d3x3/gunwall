                                                           FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ACTIVITY" Width="106">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Section 9: sparkline is stroke 1.3 in 't3', no fill.
                                                 It is a shape hint, not a value - anything louder
                                                 would compete with the row's own data. -->
