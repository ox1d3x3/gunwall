                </ScrollViewer>
            </Grid>

            <!-- ========== Activity ========== -->
            <Grid x:Name="PanelActivity" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Activity" Style="{StaticResource H1}" />
                        <TextBlock Text="New connections as they appear. Local only - nothing leaves this PC."
                                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Clear" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="ClearActivity_Click" />
                </Grid>

                <Border Grid.Row="1" Padding="0">
                    <ListView x:Name="ActivityList" gw:Table.EmptyTitle="No activity yet" gw:Table.EmptyText="Connection events for this session will appear here." VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="TIME" Width="90"
                                                DisplayMemberBinding="{Binding TimeText}" />
                                <GridViewColumn Header="PROCESS" Width="200"
                                                DisplayMemberBinding="{Binding ProcessName}" />
                                <GridViewColumn Header="EVENT" Width="460"
                                                DisplayMemberBinding="{Binding Detail}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- ========== Settings ========== -->
