                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <!-- Section 9: 3px track in 'line2', no radius, no
                                             gradient, fill in 'brand' once a row passes 60% of
                                             the column's largest. Identical treatment to the
                                             dashboard's top talkers - the two were the same
                                             component drawn two different ways, one of them
                                             a rounded blue bar with no track at all. -->
                                        <Grid Height="3" Margin="0,3,0,0">
                                            <Rectangle Fill="{DynamicResource BorderBrush}" />
                                            <Rectangle Fill="{Binding BarBrush}" HorizontalAlignment="Left"
                                                       Width="{Binding BarWidth}" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </Grid.Resources>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Apps" Style="{StaticResource Muted}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
