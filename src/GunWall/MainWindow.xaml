<ui:FluentWindow
    x:Class="GunWall.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:gw="clr-namespace:GunWall.Controls"
    xmlns:conv="clr-namespace:GunWall.Converters"
    xmlns:svc="clr-namespace:GunWall.Services"
    Title="GunWall"
    Height="760" Width="1180"
    MinHeight="640" MinWidth="1000"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Typography.NumeralAlignment="Tabular"
    PreviewKeyDown="Window_PreviewKeyDown_Search"
    ui:Design.Background="{DynamicResource BgPrimary}">
    <!-- No runtime Background is set on purpose.

         The library clears it to Transparent before applying a backdrop, but it
         does so with SetCurrentValue, which a locally set Background outranks -
         so setting one here silently prevents Mica from ever appearing. Their
         own source says it plainly: backdrop effects are not applied when the
         window has an opaque background.

         ui:Design.Background above is design-time only, so the Visual Studio
         designer still shows a surface instead of a void, exactly as the
         library's own gallery does it. -->

    <ui:FluentWindow.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToFillConverter x:Key="StatusToFill" />
        <conv:StatusToActionTextConverter x:Key="StatusToAction" />
        <conv:StatusToTextConverter x:Key="StatusToText" />
        <conv:CategoryToBrushConverter x:Key="CategoryToBrush" />
        <conv:CategoryToTextConverter x:Key="CategoryToText" />
        <conv:ProtectLabelConverter x:Key="ProtectLabel" />
        <conv:CountryFlagConverter x:Key="CountryFlag" />
        <conv:NameToBrushConverter x:Key="NameToBrush" />
        <conv:NameInitialConverter x:Key="NameInitial" />
        <conv:NullToVisibleConverter x:Key="NullToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NotEmptyToVisConverter x:Key="NotEmptyToVis" />

        <!-- Filter fields. These rendered as bare empty rectangles: a box with a
             border, no label, no placeholder, no clue what typing into it would
             do. Four of them, on four different screens.

             WPF has no placeholder property, so the template carries one. The
             text comes from Tag, which keeps the style reusable without a
             per-screen subclass, and it hides on the first keystroke via a
             trigger on Text="" - an empty string does match that trigger, which
             is the one thing about this that is not obvious.

             Same reasoning as the top bar field in 0.99.47: the library's own
             focus underline is not wanted under a box that already has a
             border, so the template is replaced rather than patched.
             PART_ContentHost is required by the TextBox contract - omit it and
             typing silently stops working while the control still draws. -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource BlockText}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource BlockFill}" />
            <Setter Property="Width" Value="220" />
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="fb" CornerRadius="7" Padding="10,0"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Collapsed by default and revealed by the Text=""
                                     trigger below. The other way round it would show
                                     the placeholder UNDER the typed text forever,
                                     since nothing would ever hide it again. -->
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" FontSize="12.5"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource TextTertiary}" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                              Background="Transparent"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="fb" Property="BorderBrush" Value="{DynamicResource TextTertiary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one sanctioned use of 'brand-hi'. Section 2 gives that token a
             single job - link hover - so it is defined here and nowhere else.
             Note it DARKENS in the light theme where it lightens in dark, which
             is why it is a palette value rather than a brightness filter over
             the accent. Setters before triggers, deliberately: a property
             element ahead of further content inside a Style is MC3088. -->
        <Style x:Key="RepoLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource BlockText}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandHi}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- the app-drawn title bar -->
            <RowDefinition Height="*" />      <!-- everything else          -->
        </Grid.RowDefinitions>

        <!-- With ExtendsContentIntoTitleBar the window no longer draws its own
             caption, so the application supplies one. This is what lets the
             backdrop run to the top edge instead of stopping under a strip of
             system chrome, and it is the single most visible difference between
             a Fluent window and a stock one.

             It carries the same shield mark used in the navigation pane, so the
             identity reads in the taskbar preview and the Alt-Tab card too. -->
        <ui:TitleBar Grid.Row="0" Title="GunWall" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <!-- The application's own icon, not a stock shield glyph. This
                     is what appears in the taskbar preview and the Alt-Tab
                     card, so it should be the mark people recognise rather than
                     a symbol that happens to mean "security". -->
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="RootGrid" Grid.Row="1">
        <!-- One row now. The second was Auto-height for the footer, and an empty
             Auto row is not visually harmless: it is a row that anything given
             Grid.Row="1" lands in silently. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar navigation ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- ===================== Brand =====================
                     A shield, because that is what the product is, drawn as one
                     continuous path rather than an icon glyph so it scales
                     cleanly and takes the theme accent. The notch cut into the
                     upper edge reads as a wall segment: the two ideas the name
                     joins. Geometry rather than a bitmap means no asset to keep
                     in step with the palette. -->
                <!-- Sidebar header, SPEC.md section 1: padding 20/20/18, logo 24,
                     wordmark 14.5 at 600, kicker 10.5 uppercase and tracked. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,18">
                    <Grid Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" /><RowDefinition Height="*" />
                            <RowDefinition Height="*" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                            <Rectangle Grid.Column="0" Grid.Row="0" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="1" Grid.Row="0" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="3" Grid.Row="0" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="0" Grid.Row="1" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="1" Grid.Row="1" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="2" Grid.Row="1" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="3" Grid.Row="1" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="0" Grid.Row="2" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="2" Grid.Row="2" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="3" Grid.Row="2" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="0" Grid.Row="3" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="1" Grid.Row="3" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="2" Grid.Row="3" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                            <Rectangle Grid.Column="3" Grid.Row="3" Fill="{DynamicResource TextPrimary}" Margin="0,0,1.5,1.5" />
                        <Rectangle Grid.Column="2" Grid.Row="0"
                                   Fill="{DynamicResource BlockText}" Margin="0,0,1.5,1.5" />
                        <Rectangle Grid.Column="1" Grid.Row="2" Margin="0,0,1.5,1.5"
                                   Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GunWall" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="ZERO TRUST EDGE" FontSize="10.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </StackPanel>
                </StackPanel>
                <!-- ===================== Posture module =====================
                     SPEC.md section 1. Docked to the BOTTOM of the sidebar, below
                     the nav, which is where the design puts it: the state you are
                     in and the two controls that change it, together, one place.

                     This replaces a card that described a rail 92 pixels wide - a
                     shield glyph with one word under it and the real sentence
                     hidden in a tooltip, because at 92 pixels nothing else fit.
                     The rail has been 238 pixels since 0.99.33. The card outlived
                     the constraint that shaped it by ten releases, and its own
                     comment still explained the reasoning.

                     Docking order matters in a DockPanel: this is declared before
                     the nav ScrollViewer so it claims the bottom edge first and
                     the nav takes what is left. Declared after, the nav would take
                     the remaining space first and this would be pushed out of
                     view entirely. -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,14" Padding="14" CornerRadius="10"
                        Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- State and control on one line. This was three lines: a
                             role dot with the state name, an ON/OFF pill, and a
                             separate field below carrying the word "Firewall" and
                             the switch. All three answered the same question. The
                             switch position IS the pill, and the state name above
                             it is what the pill was abbreviating, so there is one
                             row now: what the posture is, and the control that
                             changes it. -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="PostureDot" Width="7" Height="7" VerticalAlignment="Center"
                                         Margin="0,0,8,0" Fill="{DynamicResource WarnText}" />
                                <TextBlock x:Name="PostureName" Text="Starting..." FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="EnableFirewallButton"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Click="EnableFirewall_Click"
                                             ToolTip="Turn protection on or off. Off leaves this PC unfiltered." />
                        </Grid>

                        <!-- What the state actually means, in a sentence. This is the
                             text that used to be reachable only by hovering. -->
                        <TextBlock x:Name="PostureLine" Text="Waiting for the engine"
                                   FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                   Margin="0,9,0,0"
                                   Foreground="{DynamicResource TextTertiary}" />

                        <!-- Lockdown. Filled with the brand while engaged, because
                             the most restrictive state in the application should be
                             the one that looks it. -->
                        <Button x:Name="LockdownButton" Height="30" Margin="0,12,0,0"
                                Style="{StaticResource PostureButton}"
                                Click="LockdownButton_Click"
                                ToolTip="Block all network traffic until released.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path x:Name="LockdownIcon" Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,7,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="{StaticResource IconLock}" Fill="{x:Null}" />
                                <TextBlock x:Name="LockdownLabel" Text="Engage lockdown" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,0,12,12">
                        <TextBlock Text="MONITOR" Style="{StaticResource NavGroupHeading}" Margin="8,12,8,7" />
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Dashboard">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconOverview}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavDashboardLabel" Style="{StaticResource SideNavLabel}" Text="Overview" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavActivity" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Activity">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconActivity}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavActivityLabel" Style="{StaticResource SideNavLabel}" Text="Activity" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPackets" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Packets">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconPackets}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavPacketsLabel" Style="{StaticResource SideNavLabel}" Text="Packet log" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavConnections" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Connections">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconConnections}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavConnectionsLabel" Style="{StaticResource SideNavLabel}" Text="Connections" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTraffic" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Traffic">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconTraffic}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavTrafficLabel" Style="{StaticResource SideNavLabel}" Text="Traffic" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAlerts" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Alerts">
                            <DockPanel LastChildFill="True">
                                <Border x:Name="AlertsBadge" DockPanel.Dock="Right"
                                        Background="{DynamicResource BlockText}"
                                        CornerRadius="9" MinWidth="17" Height="17" Padding="5,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="AlertsBadgeText" Text="0" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconAlerts}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavAlertsLabel" Style="{StaticResource SideNavLabel}" Text="Alerts" />
                            </DockPanel>
                        </RadioButton>
                        <TextBlock Text="ENFORCE" Style="{StaticResource NavGroupHeading}" Margin="8,16,8,7" />
                        <RadioButton x:Name="NavFirewall" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Firewall">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconApplications}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavFirewallLabel" Style="{StaticResource SideNavLabel}" Text="Applications" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavRules" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Rules">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconRules}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavRulesLabel" Style="{StaticResource SideNavLabel}" Text="Rules" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSecurity" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Security">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSecurity}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavSecurityLabel" Style="{StaticResource SideNavLabel}" Text="Security" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDns" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Dns">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconDns}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavDnsLabel" Style="{StaticResource SideNavLabel}" Text="DNS resolver" />
                            </DockPanel>
                        </RadioButton>
                        <TextBlock Text="SYSTEM" Style="{StaticResource NavGroupHeading}" Margin="8,16,8,7" />
                        <RadioButton x:Name="NavServices" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Services">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconServices}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavServicesLabel" Style="{StaticResource SideNavLabel}" Text="Windows services" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavNetwork" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Network">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconNetwork}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavNetworkLabel" Style="{StaticResource SideNavLabel}" Text="Network scan" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource SideNavButton}" Checked="Nav_Checked" Tag="Settings">
                            <DockPanel LastChildFill="True">
                                <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSettings}" VerticalAlignment="Center"
                                               Margin="0,0,11,0" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="NavSettingsLabel" Style="{StaticResource SideNavLabel}" Text="Settings" />
                            </DockPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Main column =====================
             Given its own surface, one step lighter than the window and two
             lighter than the rail. Depth in a dark interface comes from
             separating surfaces rather than from shadows, and this column
             previously had none of its own - it showed whatever was behind it,
             which is what made the window read as one flat sheet. -->
        <Grid Grid.Column="1" Background="{DynamicResource BgContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== Top bar =====================
                 SPEC.md section 1: 54 high, padding 0/24/0/28, and its bottom
                 rule is 'line' rather than the 'line2' used for control borders -
                 chrome dividers are the quieter of the two.

                 The firewall switch and lockdown button used to live here. They
                 are controls that change the posture, so they now sit with the
                 posture they change; what is left here is what the machine is
                 doing, which is a different question and belongs in a different
                 place. -->
            <Border Grid.Row="0" Height="54" Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0,24,0">
                    <!-- Search. A real input, not a picture of one: 0.99.43 placed
                         a styled Border with a tooltip explaining it was not ready
                         yet, which is dead chrome pretending to be a control. It
                         navigates now; the fuller palette with actions is still
                         0.99.48. -->
                    <Border x:Name="SearchBox" Width="300" Height="32" HorizontalAlignment="Left"
                            VerticalAlignment="Center" CornerRadius="7" Padding="11,0"
                            Cursor="Hand" MouseLeftButtonUp="SearchBox_Click"
                            ToolTip="Open the command palette (Ctrl K)"
                            Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Fill="{x:Null}"
                                  Stroke="{DynamicResource TextTertiary}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource IconSearch}" />
<TextBlock Text="Search apps, rules, addresses..." FontSize="12.5"
                                       Margin="23,0,42,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <Border x:Name="SearchChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    CornerRadius="4" Padding="5,2"
                                    Background="{DynamicResource BgElevated}">
                                <TextBlock Text="Ctrl K" FontSize="10.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- The results dropdown was replaced by the command palette in
                         0.99.67. A 300px list under the field could show destinations
                         and nothing else; the palette is where actions belong. -->

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="EngineDot" Width="6" Height="6" VerticalAlignment="Center"
                                 Margin="0,0,7,0" Fill="{DynamicResource WarnText}" />
                        <TextBlock x:Name="EngineStatus" Text="Engine: starting" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <Rectangle Width="1" Height="20" Margin="0,0,14,0"
                                   Fill="{DynamicResource Divider}" VerticalAlignment="Center" />

                        <!-- Throughput. The session totals that the footer used to
                             carry are on these two as tooltips: the rate is the
                             glanceable number, the session total is the one you go
                             looking for. -->
                        <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                              Margin="0,0,5,0" Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="2.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource IconArrowUp}" Fill="{x:Null}" />
                        <TextBlock x:Name="TopUp" Text="0 B/s" FontSize="11.5"
                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                   Margin="0,0,14,0" Foreground="{DynamicResource TextSecondary}" />

                        <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                              Margin="0,0,5,0" Stroke="{DynamicResource BlockText}"
                              StrokeThickness="2.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource IconArrowDown}" Fill="{x:Null}" />
                        <TextBlock x:Name="TopDown" Text="0 B/s" FontSize="11.5"
                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                   Margin="0,0,14,0" Foreground="{DynamicResource TextSecondary}" />

                        <!-- The design specifies a 30x30 icon button here. Kept as the
                             animated switch by an explicit decision: the icon rides
                             inside the knob, so it shows which theme you are in
                             rather than that two exist. Recorded as a deliberate
                             deviation, not an oversight. -->
                        <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeSwitch}"
                                      Click="ThemeToggle_Click" VerticalAlignment="Center"
                                      ToolTip="Switch between the dark and light theme" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Content area ===================== -->
            <!-- Page padding, SPEC.md section 1: 30 top / 36 sides / 44 bottom. The
                 asymmetry is deliberate - the extra at the bottom stops the last
                 row of a long table sitting flush on the window edge, which is
                 what a uniform 24 was doing on every screen. -->
            <Grid Grid.Row="1" Margin="36,30,36,44" x:Name="PanelHost" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform><TranslateTransform x:Name="PanelHostShift" /></Grid.RenderTransform>

            <!-- ========== Dashboard ========== -->
            <Grid x:Name="PanelDashboard">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- hero -->
                    <RowDefinition Height="Auto" />   <!-- stats -->
                    <RowDefinition Height="Auto" />   <!-- chart, fixed height -->
                    <RowDefinition Height="*" />      <!-- talkers + decisions take the rest -->
                </Grid.RowDefinitions>

                <!-- Dashboard hero, SPEC.md. The page leads with a statement of
                     posture rather than a title: a kicker naming where the rules
                     live, the state at 46px, one sentence of consequence, the
                     actions, and a meta column on the right. The old form put a
                     generic "Dashboard" heading above a card that said the same
                     thing in smaller type - two rows spent saying it twice. -->
                <Grid Grid.Row="0" Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MaxWidth="620" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="HeroDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Margin="0,0,9,0" Fill="{DynamicResource AllowText}" />
                            <TextBlock x:Name="HeroKicker" Text="RULES ENFORCED IN KERNEL"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AllowText}" />
                        </StackPanel>

                        <TextBlock x:Name="HeroTitle" Text="Protected" FontSize="46"
                                   FontWeight="SemiBold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimary}" />

                        <TextBlock x:Name="HeroBody" TextWrapping="Wrap" FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Your ruleset is live in the kernel. New applications raise a prompt before their first connection is allowed through." />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <!-- The hero used to carry a primary button that turned
                                 the firewall on and off, and lifted lockdown. Both
                                 of those are the posture module's job now, and a
                                 control offered twice on one screen is a control
                                 you have to check the state of twice.

                                 What survives is Resume, because a snooze is the
                                 one state with no other way out: the switch would
                                 read as already on, and lockdown is not engaged.
                                 It is hidden in every other state rather than
                                 relabelled, so this button means one thing. -->
                            <Button x:Name="HeroPrimary" Style="{StaticResource PrimaryButton}"
                                    Click="Snooze_Click" Tag="0" Content="Resume now"
                                    Visibility="Collapsed" Margin="0,0,10,0" />
                            <Button x:Name="HeroSnooze" Style="{StaticResource ActionButton}"
                                    Click="Snooze_Click" Tag="15" Content="Snooze 15 min" Margin="0,0,10,0" />
                            <Button Style="{StaticResource ActionButton}"
                                    Click="CheckUpdate_Click" Content="Check for updates" />
                        </StackPanel>

                        <!-- Directly beneath the actions it reports on. Pinned to
                             a row edge it collided with whatever that row held -
                             first the chart card, then the statistics labels. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock x:Name="SnoozeStatus" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="ResumeButton" Style="{StaticResource ActionButton}"
                                    Click="Resume_Click" Content="Resume now"
                                    Visibility="Collapsed" Margin="0,0,10,0" />
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Meta column: facts that answer "since when, and which
                         ruleset?" - the questions a posture claim invites. -->
                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="32,4,0,0" MinWidth="210">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Since" FontSize="12.5"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MetaSince" Text="—"
                                   Style="{StaticResource DataCell}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Uptime" FontSize="12.5"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MetaUptime" Text="—"
                                   Style="{StaticResource DataCell}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ruleset" FontSize="12.5"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MetaRuleset" Text="—"
                                   Style="{StaticResource DataCell}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mode" FontSize="12.5"
                                   Foreground="{DynamicResource TextTertiary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MetaMode" Text="—"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                </Grid>


                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- The rate figures live in the chart's header, which is
                             where the design puts them: they are the chart's
                             values, and as separate cards above it they repeated
                             what the graph already shows while costing a whole
                             row. The 8x2 colour tick sits above each label
                             instead of a legend box. -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,42,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Rectangle Width="8" Height="2" VerticalAlignment="Center"
                                               Margin="0,0,7,0" Fill="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="UPLOAD" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                                <TextBlock x:Name="UpSpeed" Text="0 B/s" FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="SessionUp" Text="" FontSize="11.5" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,42,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Rectangle Width="8" Height="2" VerticalAlignment="Center"
                                               Margin="0,0,7,0" Fill="{DynamicResource BlockText}" />
                                    <TextBlock Text="DOWNLOAD" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>
                                <TextBlock x:Name="DownSpeed" Text="0 B/s" FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="SessionDown" Text="" FontSize="11.5" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ACTIVE CONNECTIONS" FontSize="10.5"
                                           FontWeight="SemiBold" Margin="0,0,0,7"
                                           Foreground="{DynamicResource TextTertiary}" />
                                <TextBlock x:Name="ConnCount" Text="0" FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="LAST 60 SECONDS" FontSize="10.5"
                                       FontWeight="SemiBold" VerticalAlignment="Top"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextTertiary}" />
                        </Grid>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="Collapsed">
                            <TextBlock Text="THROUGHPUT (LAST 60S)" Style="{StaticResource SectionLabel}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource InboundBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Down" Style="{StaticResource Muted}" Margin="6,0,16,0" />
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource OutboundBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Up" Style="{StaticResource Muted}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 230 for the plot area, which puts the card at roughly the
                             310 the design draws. Fixed rather than star-sized: see the
                             row definitions above. -->
                        <Grid Grid.Row="1" Height="230">
                            <Canvas x:Name="GraphCanvas" ClipToBounds="True" Background="Transparent"
                                    SizeChanged="GraphCanvas_SizeChanged"
                                    MouseMove="GraphCanvas_MouseMove" MouseLeave="GraphCanvas_MouseLeave" />
                            <Canvas x:Name="GraphOverlay" IsHitTestVisible="False" ClipToBounds="True">
                                <Rectangle x:Name="GraphCursorLine" Width="1" Fill="{DynamicResource GraphCursor}"
                                           Visibility="Collapsed" />
                                <Border x:Name="GraphTooltip" Visibility="Collapsed" CornerRadius="6"
                                        Background="{DynamicResource BgElevated}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="9,6">
                                    <StackPanel>
                                        <TextBlock x:Name="GraphTooltipTime" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="GraphTooltipDown" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InboundBrush}" />
                                        <TextBlock x:Name="GraphTooltipUp" FontSize="11.5"
                                                   Foreground="{DynamicResource OutboundBrush}" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
                <!-- The six figures, as a divided row directly under the hero.
                     The design separates them with hairlines rather than putting
                     them in a card: they are a readout, not an object. -->
                <Grid Grid.Row="1" Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="0,0,0,0"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Stat_Click" Tag="Firewall">
                        <StackPanel>
                            <TextBlock Text="APPS SEEN" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                            <TextBlock x:Name="StatApps" Text="0" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}" Padding="22,0,0,0"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Stat_Click" Tag="Firewall">
                        <StackPanel>
                            <TextBlock Text="BLOCKED" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                            <TextBlock x:Name="StatBlocked" Text="0" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BlockText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}" Padding="22,0,0,0"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Stat_Click" Tag="Firewall">
                        <StackPanel>
                            <TextBlock Text="ALLOWED" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                            <!-- 't1', not green. Blocked-in-brand is the design's one sanctioned
                                 decorative use of the accent; Allowed is deliberately not
                                 its mirror. Green is a state colour and a running total is
                                 not a state. -->
                            <TextBlock x:Name="StatAllowed" Text="0" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}" Padding="22,0,0,0"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Stat_Click" Tag="Rules">
                        <StackPanel>
                            <TextBlock Text="CUSTOM RULES" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                            <TextBlock x:Name="StatRules" Text="0" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}" Padding="22,0,0,0"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Stat_Click" Tag="Rules">
                        <StackPanel>
                            <TextBlock Text="SYSTEM RULES" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                            <TextBlock x:Name="StatSystem" Text="0" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}" Padding="22,0,0,0"
                            Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Stat_Click" Tag="Dns">
                        <StackPanel>
                            <TextBlock Text="BLOCKLISTED" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,9" />
                            <TextBlock x:Name="StatBlocklist" Text="0" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status lines that lived in the block the hero replaced. They
                     are surfaced only when they have something to say. -->

                <!-- Top talkers and recent decisions, side by side. The design
                     puts them here because a posture claim invites two
                     questions - what is using the network, and what has GunWall
                     just done about it - and both should be answerable without
                     leaving the page. -->
                <Grid Grid.Row="3" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOP TALKERS" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,14" />
                        <ItemsControl x:Name="TopTalkersList" Focusable="False" FocusVisualStyle="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Text="{Binding SizeText}"
                                                   Style="{StaticResource DataCell}"
                                                   HorizontalAlignment="Right" />
                                        <!-- Share bar: 3px, no radius, no gradient. Red once a
                                             row passes 60% of the largest, grey below - so the
                                             colour marks the outlier rather than decorating
                                             every row. -->
                                        <Grid Grid.Row="1" Height="3" Margin="0,7,0,0">
                                            <Rectangle Fill="{DynamicResource BorderBrush}" />
                                            <Rectangle Fill="{Binding BarBrush}"
                                                       HorizontalAlignment="Left"
                                                       Width="{Binding BarWidth}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TopTalkersEmpty" Text="Nothing measured yet."
                                   Style="{StaticResource Muted}" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,14" LastChildFill="False">
                            <TextBlock Text="RECENT DECISIONS" Style="{StaticResource SectionLabel}"
                                       DockPanel.Dock="Left" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}"
                                    Click="OpenPacketLog_Click" Content="Open packet log"
                                    MinHeight="0" Padding="0" BorderThickness="0"
                                    Background="Transparent" FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}" />
                        </DockPanel>
                        <ItemsControl x:Name="RecentDecisionsList" Focusable="False" FocusVisualStyle="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                                   Style="{StaticResource DataCell}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding AppName}"
                                                   FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding RemoteEndpoint}"
                                                   Style="{StaticResource DataCell}"
                                                   Margin="0,0,16,0" />
                                        <Border Grid.Column="3" CornerRadius="5" Padding="8,2.5"
                                                Background="{Binding ActionFill}">
                                            <TextBlock Text="{Binding Action}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding ActionBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RecentDecisionsEmpty" Text="No decisions yet this session."
                                   Style="{StaticResource Muted}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- ========== Firewall ========== -->
            <Grid x:Name="PanelFirewall" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                            <TextBlock Text="Firewall" Style="{StaticResource H1}" VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowAllAppsCheck" Content="Show all running apps"
                                      Foreground="{DynamicResource TextSecondary}"
                                      VerticalAlignment="Center" Margin="24,4,0,0"
                                      Checked="ShowAllApps_Changed" Unchecked="ShowAllApps_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="AppSearch" Tag="Filter applications..." Style="{StaticResource SearchBox}"
                                     TextChanged="AppSearch_TextChanged" Margin="0,0,8,0"
                                     ToolTip="Search applications" />
                            <Button Content="Block an app" Style="{StaticResource ActionButton}"
                                    Click="BrowseBlock_Click" Margin="0,0,8,0" />
                            <Button Content="Purge unused" Style="{StaticResource ActionButton}"
                                    Click="PurgeUnused_Click" Margin="0,0,8,0"
                                    ToolTip="Forget apps that have no allow/block rule (they'll prompt again)" />
                            <Button Content="Purge expired timers" Style="{StaticResource ActionButton}"
                                    Click="PurgeExpiredTimers_Click" Margin="0,0,8,0"
                                    ToolTip="Clear any timed blocks whose timer has already elapsed" />
                            <Button Content="Refresh" Style="{StaticResource ActionButton}"
                                    Click="RefreshApps_Click" />
                        </StackPanel>
                    </Grid>
                    <!-- The signature legend. These four are the CATEGORY colours,
                         which SPEC section 2 calls out as user data rather than
                         chrome: they are configurable on Settings, and they are the
                         one place a hue outside the palette is legitimate. They were
                         drawing from a generic four-colour chart series instead, so
                         the legend and the dots it explains could disagree - and did,
                         the moment anyone edited a colour. Both now read
                         CategoryPalette, and RefreshSwatches repaints all three
                         places at once. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                        <Ellipse x:Name="LegendSignedDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Signed" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                        <Ellipse x:Name="LegendUnsignedDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Unsigned" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                        <Ellipse x:Name="LegendSystemDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="System" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                        <Ellipse x:Name="LegendInvalidDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Invalid sig" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Padding="0">
                    <ListView x:Name="AppsList" gw:Table.EmptyTitle="No applications yet" gw:Table.EmptyText="They appear here the first time each one tries to reach the network." VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseRightButtonDown="Row_RightClickSelect">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ContextMenu>
                            <ContextMenu Opened="AppsContextMenu_Opened">
                                <MenuItem Header="Mute (allow, no popups)" Click="MuteApp_Click" />
                                <MenuItem Header="Unmute" Click="UnmuteApp_Click" />
                                <Separator />
                                <MenuItem Header="Scan with VirusTotal" Click="ScanVt_Click" />
                                <Separator />
                                <MenuItem Header="Block outbound only" Click="BlockDirection_Click" Tag="out" />
                                <MenuItem Header="Block inbound only" Click="BlockDirection_Click" Tag="in" />
                                <MenuItem Header="Block by network scope">
                                    <MenuItem x:Name="ScopeLocalItem" Header="Block device-local (loopback)"
                                              IsCheckable="True" Click="ScopeBlock_Click" Tag="local" />
                                    <MenuItem x:Name="ScopeLanItem" Header="Block local network (LAN)"
                                              IsCheckable="True" Click="ScopeBlock_Click" Tag="lan" />
                                    <MenuItem x:Name="ScopeIncomingItem" Header="Block incoming connections"
                                              IsCheckable="True" Click="ScopeBlock_Click" Tag="incoming" />
                                    <MenuItem x:Name="ScopeServerItem" Header="Block server / listening sockets"
                                              IsCheckable="True" Click="ScopeBlock_Click" Tag="server"
                                              ToolTip="Stops this app opening any listening port (TCP or UDP), so it can never accept incoming connections. Remove it if the app hosts a server, game lobby, or peer-to-peer transfer." />
                                    <MenuItem x:Name="ScopeInternetItem" Header="Block Internet (allow LAN only)"
                                              IsCheckable="True" Click="ScopeBlock_Click" Tag="internet" />
                                    <MenuItem x:Name="ScopeP2pItem" Header="Block P2P / direct connections"
                                              IsCheckable="True" Click="ScopeBlock_Click" Tag="p2p"
                                              ToolTip="Reactively blocks connections to public IPs the app never looked up via DNS. Needs GunWall's DNS resolver running." />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Block for 15 minutes" Click="BlockTemp_Click" Tag="15" />
                                <MenuItem Header="Block for 1 hour" Click="BlockTemp_Click" Tag="60" />
