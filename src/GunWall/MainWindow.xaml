                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Traffic type" Style="{StaticResource Muted}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl x:Name="BreakTypes" Focusable="False" FocusVisualStyle="{x:Null}" ItemTemplate="{StaticResource BreakRowTemplate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Countries" Style="{StaticResource Muted}" FontSize="11"
                                           FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl x:Name="BreakCountries" Focusable="False" FocusVisualStyle="{x:Null}" ItemTemplate="{StaticResource BreakRowTemplate}" />
                                <TextBlock x:Name="BreakCountriesHint" Visibility="Collapsed"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,2,16,0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="No country data. The GeoIP database hasn't been downloaded, so country, continent and ASN rules can't match. Set it up in Security &#8594; GeoIP." />
