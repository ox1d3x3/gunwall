                    </ListView>
                </Border>
            </Grid>

            <!-- ========== Connections ========== -->
            <Grid x:Name="PanelConnections" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Connections" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="GeoStatus" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="GeoDownloadBtn" Content="Download GeoIP data"
                                Style="{StaticResource ActionButton}" Click="GeoDownload_Click"
                                Margin="0,0,8,0"
                                ToolTip="Fetch the free country/ASN database so each connection shows its location" />
                        <TextBox x:Name="ConnSearch" Tag="Filter connections..." Style="{StaticResource SearchBox}"
                                 TextChanged="ConnSearch_TextChanged" ToolTip="Search connections" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="0">
                    <ListView x:Name="ConnList" gw:Table.EmptyTitle="No active connections" gw:Table.EmptyText="Nothing is talking to the network right now." VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SizeChanged="ConnList_SizeChanged"
                              SelectionChanged="ConnSelected"
                              PreviewMouseRightButtonDown="Row_RightClickSelect">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Close this connection" Click="CloseConn_Click" />
                                <MenuItem Header="Block this app" Click="BlockConnApp_Click" />
                                <MenuItem Header="Block app and close connections" Click="BlockAndCloseConn_Click" />
                                <Separator />
                                <MenuItem Header="End process (terminate)" Click="KillProcess_Click" />
                                <Separator />
                                <MenuItem Header="Copy remote address" Click="CopyConnRemote_Click" />
                                <Separator />
                                <MenuItem Header="Fit columns to content" Click="FitColumns_Click" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="PROCESS" Width="210">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessDisplay}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ServicesDetail}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="PID" Width="56"
                                                DisplayMemberBinding="{Binding ProcessId}" />
                                <GridViewColumn Header="PROTO" Width="66"
                                                DisplayMemberBinding="{Binding Protocol}" />
                                <GridViewColumn Header="LOCAL" Width="175">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LocalEndpoint}" Style="{StaticResource DataCell}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                <GridViewColumn Header="REMOTE" Width="195">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RemoteEndpoint}" Style="{StaticResource DataCell}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                <GridViewColumn Header="LOCATION" Width="196">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Grid, not StackPanel. TextTrimming only engages when the
                                                 TextBlock is width-constrained, and a horizontal
                                                 StackPanel measures its children with INFINITE
                                                 width - so the ellipsis request is honoured by the
                                                 layout system as "no overflow, nothing to trim"
                                                 while the cell boundary clips the glyphs anyway.
                                                 The result reads as a value that ENDS mid-word:
                                                 "AS200107 K". Auto for the flag, star for the text,
                                                 and the constraint exists. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Width="20" Height="14" Margin="0,0,7,0"
                                                       VerticalAlignment="Center" Stretch="Uniform"
                                                       SnapsToDevicePixels="True"
                                                       Source="{Binding Country, Converter={StaticResource CountryFlag}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Location}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Location}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- STATE was here until 0.99.50. The design's Connections
                                     table has six columns and carries state in the
                                     inspector - which this build already did, so the
                                     column repeated what the panel beside it says. It was
                                     also the column being pushed off the right edge at
                                     ordinary window widths, so it was both redundant and
                                     the thing actually breaking. -->
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- ===== §11 master-detail inspector =====
                     Collapsed until a row is selected. It was a 340px empty card
                     holding one line of instruction, permanently, on the screen
                     with the widest table in the application - which is to say it
                     spent a third of the width telling you it had nothing to show
                     while squeezing the thing you were actually reading.

                     Collapsed rather than hidden: Visibility="Collapsed" on the
                     Border removes it from layout, so the table takes the width
                     back rather than leaving a gap where the panel used to be. -->
                <!-- Collapsed until a row is picked, and closed again when the
                     selection really goes away. "Really" is the whole difficulty:
                     the list clears and refills every sample, so it deselects
                     transiently once a second, and closing on that would flicker.
                     RebuildConnList raises a guard for the duration and decides
                     once, after the refill has settled - see ConnSelected.

                     There is no empty state INSIDE the panel. A panel that
                     collapses when nothing is selected has no state in which a
                     placeholder could be seen; 0.99.73 carried one that was
                     unreachable in markup, and it has been removed rather than
                     left to look like a feature.

                     The width the panel takes and gives back is absorbed by the
                     table's last column, not by the rows clipping. -->
                <Border x:Name="ConnInspector" Grid.Column="1" Width="340" Margin="12,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ScrollViewer x:Name="InspContent"
                                      VerticalScrollBarVisibility="Auto" Padding="18,16">
                            <StackPanel>
                                <TextBlock x:Name="InspProcess" Style="{StaticResource H2}" TextWrapping="Wrap" />
                                <TextBlock x:Name="InspSub" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />

                                <TextBlock Text="CONNECTION" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,18,0,4" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspType" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Local" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspLocal" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Remote" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspRemote" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="State" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspState" FontSize="12" TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Text="LOCATION" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,18,0,4" />
                                <StackPanel x:Name="InspLocRow" Orientation="Horizontal" Margin="0,3,0,0">
                                    <Image x:Name="InspFlag" Width="34" Height="24" Margin="0,0,9,0"
                                           VerticalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True" />
                                    <TextBlock x:Name="InspCountry" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                                </StackPanel>
                                <Grid x:Name="InspAsnRow" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ASN" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspAsn" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid x:Name="InspOwnerRow" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Operator" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspOwner" FontSize="12" TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Text="APPLICATION" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,18,0,4" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Path" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspPath" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Why" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspVerdict" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Policy" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspStatus" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                                <Grid x:Name="InspScopeRow" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scope" Style="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" x:Name="InspScope" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                </Grid>
            </Grid>

            <!-- ========== Traffic ========== -->
            <!-- A ScrollViewer, as PanelRules and PanelSettings already are.
                 It was a plain Grid whose fourth row was star-sized, sitting after
                 a fixed 500px map and before two large Auto cards. The star row
                 therefore got whatever was left of the viewport, which on a normal
                 window was nothing - and on a slightly taller one was about 35px:
                 enough to draw TOP COUNTRIES and MOST ACTIVE APPS and not enough
                 for either list beneath them. Two labels over empty space.

                 A star row inside a scroller is measured against its content rather
                 than the viewport, so the row is Auto now and says so. The panel
                 also stopped clipping its last card off the bottom edge on shorter
                 windows, which it had been doing silently. -->
            <ScrollViewer x:Name="PanelTraffic" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- metering banner, collapsed when measured -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />  <!-- was *, which meant "the scraps" -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- SPEC.md section 10, degraded state: 'warn-bg' on a 1px 'warn'
                     hairline, 8px radius, above the header. This is where the
                     footer's metering readout went. It states a caveat about how
                     to read the figures below it, so it belongs on the screen with
                     the figures, and only while the caveat applies - which is what
                     a permanent label everywhere could not express. -->
                <Border x:Name="MeteringBanner" Grid.Row="0" Visibility="Collapsed"
                        CornerRadius="8" Padding="12,9" Margin="0,0,0,14"
                        Background="{DynamicResource WarnFill}"
                        BorderBrush="{DynamicResource WarnText}" BorderThickness="1">
