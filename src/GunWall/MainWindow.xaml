                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- ========== DNS resolver ========== -->
            <Grid x:Name="PanelDns" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DNS resolver" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   MaxWidth="960" HorizontalAlignment="Left"
                                   Text="GunWall's own local resolver. It logs every domain looked up through it, blocks the ones you list, encrypts lookups over HTTPS, and caches answers so repeats are instant. It binds to 127.0.0.1 and ::1 only, and never changes this PC's DNS settings by itself - point something at it deliberately to use it. It also supplies the name-to-address history behind domain rules and the 'block direct connections' scope. This is separate from Security -&gt; Filtering DNS, which only picks an upstream provider." />
                    </StackPanel>
                </Grid>

                <!-- controls + stats -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Listen port (loopback)" Style="{StaticResource Muted}" Margin="2,0,0,3" />
                                <TextBox x:Name="DnsPortBox" Width="96" MinHeight="33" Text="53"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Port on 127.0.0.1. Standard DNS is 53; use another (e.g. 5335) if 53 is taken." />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Upstream DNS" Style="{StaticResource Muted}" Margin="2,0,0,3" />
                                <TextBox x:Name="DnsUpstreamBox" Width="170" MinHeight="33" Text="1.1.1.1"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Where allowed queries are forwarded (e.g. 1.1.1.1 or 8.8.8.8). Optional :port." />
                            </StackPanel>
                            <Button x:Name="DnsStartBtn" Content="Start resolver" Style="{StaticResource PrimaryButton}"
                                    Click="DnsStart_Click" Padding="16,9" VerticalAlignment="Bottom" />
                            <Button x:Name="DnsPathTestBtn" Content="Test DNS path" Style="{StaticResource ActionButton}"
                                    Click="DnsPathTest_Click" Padding="14,9" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    ToolTip="Sends a real DNS query to GunWall's own resolver over loopback, exactly as Windows does, and reports what came back." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Secure DNS (encrypted)" Style="{StaticResource Muted}" Margin="2,0,0,3" />
                                <ComboBox x:Name="DnsDohCombo" Width="238"
                                          SelectionChanged="DnsDoh_Changed"
                                          ToolTip="Forward queries over HTTPS (DNS-over-HTTPS) so nobody on the network can read or tamper with them." />
                            </StackPanel>
                            <StackPanel x:Name="DnsDohCustomPanel" Margin="0,0,10,0" Visibility="Collapsed">
                                <TextBlock Text="Custom DoH URL" Style="{StaticResource Muted}" Margin="2,0,0,3" />
                                <TextBox x:Name="DnsDohUrlBox" Width="250" MinHeight="33"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Must be https://  e.g. https://dns.example/dns-query" />
                            </StackPanel>
                            <CheckBox x:Name="DnsObserveCheck" Content="Watch system DNS lookups"
                                      Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                      Margin="0,14,18,0" IsChecked="True"
                                      Checked="DnsObserve_Changed" Unchecked="DnsObserve_Changed"
                                      ToolTip="Passively watches the lookups this PC makes, so domain rules and 'block direct connections' know which name produced an address. Nothing is intercepted, redirected or answered - your DNS settings are never touched." />
                            <CheckBox x:Name="DnsCloakCheck" Content="Block CNAME-cloaked trackers"
                                      Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                      Margin="0,14,18,0" IsChecked="True"
                                      ToolTip="Follows each answer's CNAME chain and blocks it if any hop is on the blocklist - catching trackers that hide behind a clean first-party subdomain." />
                            <CheckBox x:Name="DnsDohFallbackCheck" Content="Fall back to plaintext if encryption fails"
                                      Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                      Margin="0,14,0,0"
                                      ToolTip="Off (recommended): if the encrypted resolver can't be reached, lookups fail instead of silently downgrading to unencrypted DNS." />
                        </StackPanel>
                        <TextBlock x:Name="DnsResStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Stopped. Start the resolver, then point a DNS query (or this PC's DNS) at 127.0.0.1 to use it." />

                        <UniformGrid Rows="1" Columns="6" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="DnsStatQueries" Text="0" Style="{StaticResource H2}" />
                                <TextBlock Text="Queries" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DnsStatForwarded" Text="0" Style="{StaticResource H2}" />
                                <TextBlock Text="Forwarded" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DnsStatCached" Text="0" Style="{StaticResource H2}" />
                                <TextBlock Text="Cached" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DnsStatBlocked" Text="0" Style="{StaticResource H2}" />
                                <TextBlock Text="Blocked" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DnsStatCloaked" Text="0" Style="{StaticResource H2}" />
                                <TextBlock Text="Cloaked" Style="{StaticResource Muted}"
                                           ToolTip="Trackers caught hiding behind a clean-looking first-party name via CNAME aliasing." />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DnsStatObserved" Text="0" Style="{StaticResource H2}" />
                                <TextBlock Text="Names known" Style="{StaticResource Muted}"
                                           ToolTip="Addresses GunWall can attribute to a domain name. Domain rules and 'block direct connections' rely on this." />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- log + blocklist -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="0" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="QUERY LOG" Style="{StaticResource SectionLabel}" Margin="4,2,0,8" />
                            <ListView x:Name="DnsLog" gw:Table.EmptyTitle="Nothing is using this resolver yet" gw:Table.EmptyText="This log fills only with lookups sent to 127.0.0.1. Set an adapter's DNS server to 127.0.0.1 to route them here - 'Watch system DNS lookups' does not fill this log." BorderThickness="0" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="TIME" Width="84" DisplayMemberBinding="{Binding TimeText}" />
                                        <GridViewColumn Header="DOMAIN" Width="320" DisplayMemberBinding="{Binding Domain}" />
                                        <GridViewColumn Header="TYPE" Width="64" DisplayMemberBinding="{Binding Type}" />
                                        <GridViewColumn Header="ACTION" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActionText}" Value="Blocked">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BlockText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ActionText}" Value="Cloaked">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BlockText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ActionText}" Value="Forwarded">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AllowText}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ActionText}" Value="Cached">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AllowText}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="BLOCKLIST" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="One domain per line; subdomains are included, so example.com also covers ads.example.com. Hosts-style '0.0.0.0 domain' lines and pasted URLs are understood. Prefix a line with @@ to ALLOW it instead - @@example.com keeps that name working even when a category or preset blocks it, so one bad entry in a hundred-thousand-domain list does not mean turning the whole category off. Blocking works two ways: lookups sent to GunWall's resolver return NXDOMAIN, and - with 'Watch system DNS lookups' on - connections to addresses a blocked domain resolved to are blocked in the kernel. The second covers the whole PC, but only for lookups Windows performs: a browser with its own encrypted DNS turned on (Edge and Chrome call it 'Secure DNS') never asks Windows, so GunWall cannot tell which name its connections belong to. Turn that setting off in the browser for blocking to apply to it." />
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button x:Name="DnsPresetBtn" Content="Download ads + malware preset"
                                        Style="{StaticResource ActionButton}" Click="DnsPreset_Click"
                                        Padding="12,7" HorizontalAlignment="Left"
                                        ToolTip="Fetches the StevenBlack unified hosts list (~100k ad/malware domains) and blocks them in this resolver. Stored as dns-blocklist-preset.txt beside the app. Your own lines below stay separate." />
                                <TextBlock x:Name="DnsPresetStatus" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="DnsClearCacheBtn" DockPanel.Dock="Bottom" Content="Clear resolver cache"
                                    Style="{StaticResource ActionButton}" Click="DnsClearCache_Click" Padding="16,8" Margin="0,6,0,0"
                                    ToolTip="Drops all cached answers so blocklist changes take effect immediately instead of waiting for TTLs to expire." />
                            <Button x:Name="DnsApplyBlockBtn" DockPanel.Dock="Bottom" Content="Apply blocklist"
                                    Style="{StaticResource PrimaryButton}" Click="DnsApplyBlock_Click" Padding="16,8" Margin="0,8,0,0" />
                            <TextBox x:Name="DnsBlockBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" FontFamily="Consolas" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== §13 Notification center ========== -->
            <Grid x:Name="PanelAlerts" Visibility="Collapsed">
                <Grid.RowDefinitions>
