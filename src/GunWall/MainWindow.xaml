                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="TIME" Width="84" DisplayMemberBinding="{Binding TimeText}" />
                                    <GridViewColumn Header="EVENT" Width="240">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="warn">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BlockText}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="good">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AllowText}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="DETAIL" Width="520" DisplayMemberBinding="{Binding Detail}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== Packets Log ========== -->
            <Grid x:Name="PanelPackets" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

