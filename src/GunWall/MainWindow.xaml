                        </Border>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                            <Button x:Name="UsageRangeClearBtn" DockPanel.Dock="Right" Content="Show whole window"
                                    Style="{StaticResource ActionButton}" Padding="10,3"
                                    Visibility="Collapsed" Click="UsageRangeClear_Click" />
                            <TextBlock x:Name="UsageRangeText" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Drag from point A to point B on the timeline to see which apps were active then, busiest first." />
                        </DockPanel>
                        <ListView x:Name="UsageList" gw:Table.EmptyTitle="No usage recorded" gw:Table.EmptyText="Per-app totals build up as traffic flows." BorderThickness="0" Background="Transparent" MaxHeight="260"
                                  VirtualizingPanel.IsVirtualizing="True">
                        <ListView.Resources>
                            <!-- Every text cell in this table trims with an ellipsis.

                                 Scoped here rather than app-wide, and declared once per
                                 table rather than per column, because most of these
                                 columns are DisplayMemberBinding - which produces a bare
                                 TextBlock with no template to hang a setter on. Without
                                 this they cut mid-character, and a hard cut reads as the
                                 value ENDING there: "AS200107 K" looks like an operator
                                 name, not a truncated one.

                                 ListView.Resources is the right scope specifically
                                 because resource lookup walks the LOGICAL tree, and a
                                 generated row's logical parent is the ListView. The same
                                 style inside the ControlTemplate would not be found.

                                 It reaches column headers too, which is wanted: a header
                                 too narrow for its own word now shows "PRO..." rather
                                 than silently reading as "PROT". -->
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="APPLICATION" Width="280" DisplayMemberBinding="{Binding App}" />
                                    <GridViewColumn Header="DOWN" Width="110" DisplayMemberBinding="{Binding DownText}" />
                                    <GridViewColumn Header="UP" Width="110" DisplayMemberBinding="{Binding UpText}" />
                                    <GridViewColumn Header="TOTAL" Width="120" DisplayMemberBinding="{Binding TotalText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
