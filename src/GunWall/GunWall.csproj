<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>GunWall</AssemblyName>
    <RootNamespace>GunWall</RootNamespace>
    <Version>0.99.63</Version>
    <Company>GunWall</Company>
    <Product>GunWall Firewall</Product>
    <Description>A modern, open-source Windows firewall built on the Windows Filtering Platform.</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Produces a clean, self-contained single-file EXE when published.
         For normal F5 debugging in Visual Studio these are ignored. -->
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- No external NuGet packages by design: keeps the first build dependency-free. -->

  <!-- UseWindowsForms injects global usings for System.Windows.Forms and
       System.Drawing, which collide with WPF's Application/Color/Point types
       (CS0104). We fully qualify WinForms/Drawing usage, so remove them. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Country flag icons (FlagKit, MIT-licensed, public-domain artwork) embedded as
       WPF resources so the app stays a single self-contained EXE. See Flags/LICENSE-FlagKit.txt. -->
  <ItemGroup>
    <None Remove="Flags\**\*.png" />
    <Resource Include="Flags\**\*.png" />
    <!-- Also embedded as a resource, not just set as ApplicationIcon: the title
         bar loads it through a pack URI at runtime, which needs it inside the
         assembly rather than only stamped on the executable. -->
    <Resource Include="Assets\app.ico" />
    <!-- Embedded rather than relied upon: Inter Tight and JetBrains Mono are not
         Windows fonts, so the design would fall back to Segoe UI on every machine
         but a designer's. Static weight instances, because WPF's variable-font
         support renders the default instance only - a SemiBold request against a
         variable file comes back Regular with no error. OFL licences are in
         third-party-licenses/. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>


  <ItemGroup>
    <!-- WPF UI (lepoco/wpfui) - MIT. Supplies the Fluent control set and
         theming. Its licence is reproduced in third-party-licenses/, as the
         MIT terms require. This is GunWall's only package dependency; see
         docs/ARCHITECTURE.md for what that changes and what it does not. -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
