<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== LIGHT THEME =====
         The same structure inverted, with the same faint cool cast so switching
         themes changes the brightness and not the personality. Cards are pure
         white against a tinted page, which is what gives them their edge without
         needing a heavy border. -->

    <SolidColorBrush x:Key="BgPrimary"     Color="#F4F6FB" />
    <SolidColorBrush x:Key="BgSecondary"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgCard"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgElevated"    Color="#EDF1F8" />

    <SolidColorBrush x:Key="BorderBrush"   Color="#DCE3EF" />
    <SolidColorBrush x:Key="Divider"       Color="#EBEFF6" />

    <SolidColorBrush x:Key="SurfaceHover"   Color="#EDF2FA" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#E0E7F3" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#DDE9FB" />
    <SolidColorBrush x:Key="FocusRing"      Color="#2F6FE0" />

    <SolidColorBrush x:Key="TextPrimary"   Color="#141A26" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6479" />
    <SolidColorBrush x:Key="TextTertiary"  Color="#8792A6" />
    <SolidColorBrush x:Key="TextOnAccent"  Color="#FFFFFF" />

    <SolidColorBrush x:Key="AllowFill" Color="#E6F5DC" />
    <SolidColorBrush x:Key="AllowText" Color="#4E8B18" />
    <SolidColorBrush x:Key="BlockFill" Color="#FCE8E7" />
    <SolidColorBrush x:Key="BlockText" Color="#C63A31" />
    <SolidColorBrush x:Key="WarnFill"  Color="#FDF2DA" />
    <SolidColorBrush x:Key="WarnText"  Color="#96650C" />
    <SolidColorBrush x:Key="InfoFill"  Color="#E5EEFC" />
    <SolidColorBrush x:Key="InfoText"  Color="#2F6FE0" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E9F5DE" />

    <SolidColorBrush x:Key="GraphCursor"    Color="#66000000" />
    <SolidColorBrush x:Key="SelectionFill"  Color="#302F6FE0" />
    <SolidColorBrush x:Key="MapLand"        Color="#AEC0E8" />
    <SolidColorBrush x:Key="MapBorder"      Color="#8FA3D2" />

    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
