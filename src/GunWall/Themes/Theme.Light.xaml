<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== LIGHT THEME =====
         These are aliases, not a palette.

         GunWall's own surface and text tokens are referenced 115 times across
         the window and the control styles, against 18 references to the control
         library's. That ratio is why the interface kept reading as its old self
         after the library was adopted: the library was styling the controls
         while GunWall was still painting everything around them, so the two
         never agreed. Redefining these as pointers to the library's own brushes
         makes all 115 call sites resolve to its colours without touching any of
         them, and means a theme change moves the whole window at once.

         The library's surfaces are deliberately translucent, which is what lets
         the Mica material show through. A solid colour here would cancel that.

         What stays GunWall's own is below: the status colours a firewall
         actually decides with, and the chart series. Those carry meaning rather
         than surface, and the library has no opinion about them. -->

    <!-- Surfaces, matching the library's own -->
    <SolidColorBrush x:Key="BgPrimary" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="BgSecondary" Color="#EEEEEE" />
    <SolidColorBrush x:Key="BgCard" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="BgElevated" Color="#F9F9F9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="Divider" Color="#0F000000" />

    <!-- Interaction states -->
    <SolidColorBrush x:Key="SurfaceHover" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#09000000" />
    <SolidColorBrush x:Key="FocusRing" Color="#2C6EBF" />

    <!-- Type -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

    <!-- ===== GunWall's own, because they carry meaning =====
         A verdict colour is not a surface: "allowed" and "blocked" have to mean
         the same thing in either theme, and no control library can decide that. -->
    <SolidColorBrush x:Key="AllowFill" Color="#E6F5DC" />
    <SolidColorBrush x:Key="AllowText" Color="#3D7A19" />
    <SolidColorBrush x:Key="BlockFill" Color="#FCE8E7" />
    <SolidColorBrush x:Key="BlockText" Color="#B5342B" />
    <SolidColorBrush x:Key="WarnFill"  Color="#FDF2DA" />
    <SolidColorBrush x:Key="WarnText"  Color="#87590A" />
    <SolidColorBrush x:Key="InfoFill"  Color="#E5EEFC" />
    <SolidColorBrush x:Key="InfoText"  Color="#12509E" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E9F5DE" />

    <!-- Charts and the world map -->
    <SolidColorBrush x:Key="GraphCursor"   Color="#66000000" />
    <SolidColorBrush x:Key="SelectionFill" Color="#302F6FE0" />
    <SolidColorBrush x:Key="MapLand"       Color="#AEC0E8" />
    <SolidColorBrush x:Key="MapBorder"     Color="#8FA3D2" />

    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
