<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         WPF UI colour bridge (light).

         WPF UI ships its own dark palette built on neutral greys
         (#202020, #1C1C1C, #282828). GunWall's is navy (#F4F6FB,
         #FFFFFF). Left alone, the controls WPF UI styles - text
         boxes, dropdowns, menus - would sit as grey islands on navy
         panels, which looks like two applications sharing a window.

         This dictionary restates WPF UI's own tokens in GunWall's
         colours. It is merged after WPF UI's theme and before the
         control dictionary, so their templates resolve these values
         instead of their defaults.

         Note their control fills are translucent white overlays
         (#0FFFFFFF and similar) rather than solid colours; those are
         deliberately left alone, because an overlay tints to whatever
         sits beneath it and therefore already picks up our surfaces.
         Only the solid colours and the accent need restating.

         Keys are taken from WPF UI's Resources/Theme/Dark.xaml. If a
         key is renamed upstream this file quietly stops applying to
         it, which is a cosmetic regression rather than a functional
         one - worth checking after a package update.
         ============================================================ -->

    <!-- Solid surfaces, darkest to lightest, matching Theme.Light.xaml -->
    <Color x:Key="SolidBackgroundFillColorBase">#F4F6FB</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#FFFFFF</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#FFFFFF</Color>
    <Color x:Key="SolidBackgroundFillColorQuarternary">#EDF1F8</Color>
    <Color x:Key="SolidBackgroundFillColorBaseAlt">#E8EDF5</Color>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#EDF1F8" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#E8EDF5" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F4F6FB" />

    <!-- Type, matching TextPrimary / TextSecondary / TextTertiary -->
    <Color x:Key="TextFillColorPrimary">#141A26</Color>
    <Color x:Key="TextFillColorSecondary">#5A6479</Color>
    <Color x:Key="TextFillColorTertiary">#8792A6</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#141A26" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5A6479" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8792A6" />

    <!-- The interaction accent, so their controls agree with ours -->
    <Color x:Key="SystemAccentColor">#2F6FE0</Color>
    <Color x:Key="SystemAccentColorPrimary">#2F6FE0</Color>
    <Color x:Key="SystemAccentColorSecondary">#245BC0</Color>
    <Color x:Key="SystemAccentColorTertiary">#5B8DEF</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#245BC0" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#5B8DEF" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2F6FE0" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#5B8DEF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#245BC0" />
</ResourceDictionary>
