<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================================
         Icon geometry, SPEC.md section 12.

         The design draws on Lucide and says plainly not to substitute Segoe
         Fluent Icons - the two have different optical weight and a different
         corner language, and mixing them is visible immediately. Every path
         below was taken from the rendered design source rather than recalled,
         for the same reason a WFP GUID is never recalled: geometry that is
         almost right produces a picture that looks almost right, and nothing
         fails loudly enough to notice.

         CONVERSION NOTES

         The design's icons are not all <path>. Across the set they use circle,
         ellipse, rect with a corner radius, line, polyline and path, so this is
         not one mechanical substitution:

           <circle>    -> A pair of 180-degree arcs. A single arc cannot close a
                          full circle in either SVG or WPF, because the start and
                          end points would coincide and the sweep is undefined.
           <ellipse>   -> Same, with different x and y radii.
           <rect rx>   -> Corner arcs between straight edges, drawn clockwise.
           <line>      -> A two-point open figure.
           <polyline>  -> An open figure. It must NOT be closed: a polyline in
                          SVG has no closing segment, and adding "Z" turns a tick
                          into a triangle.
           <path>      -> Copied verbatim. WPF's mini-language accepts the same
                          M/L/A/C/Q/Z grammar for the subset used here.

         All of these are STROKED, never filled. Fill="{x:Null}" is not optional:
         an unfilled Lucide glyph left to fill renders as a solid blob.

         SIZING. These are authored on a 24-unit canvas and drawn much smaller.
         Wrapping in a Viewbox scales the stroke down with the shape - which is
         correct, and worth stating because it looks like a bug. SVG behaves
         identically: stroke-width is in user units, so 1.7 units on a 24 viewBox
         rendered at 16px is 1.13 device pixels either way. Scaling the stroke is
         what MATCHES the design; holding it constant would not.
         ===================================================================== -->

    <!-- ===================== Sidebar navigation ===================== -->

    <!-- Overview: panel split with a header rule. -->
    <GeometryGroup x:Key="IconOverview">
        <RectangleGeometry Rect="3,3,18,18" RadiusX="2.5" RadiusY="2.5" />
        <LineGeometry StartPoint="9,3" EndPoint="9,21" />
        <LineGeometry StartPoint="9,11" EndPoint="21,11" />
    </GeometryGroup>

    <!-- Activity: a clock with a rewind arc. -->
    <GeometryGroup x:Key="IconActivity">
        <PathGeometry Figures="M3.2,12 a8.8,8.8 0 1 0 2.6,-6.2" />
        <PathGeometry Figures="M3,4.5 L3,9 L7.5,9" />
        <PathGeometry Figures="M12,7.5 L12,12 L15,13.8" />
    </GeometryGroup>

    <!-- Packet log: a document with a folded corner. -->
    <GeometryGroup x:Key="IconPackets">
        <PathGeometry Figures="M14,3 H6.5 A1.5,1.5 0 0 0 5,4.5 V19.5 A1.5,1.5 0 0 0 6.5,21 H17.5 A1.5,1.5 0 0 0 19,19.5 V8 Z" />
        <PathGeometry Figures="M14,3 L14,8 L19,8" />
        <LineGeometry StartPoint="8.5,13.5" EndPoint="15,13.5" />
    </GeometryGroup>

    <!-- Connections: two nodes joined, with an orbit. -->
    <GeometryGroup x:Key="IconConnections">
        <EllipseGeometry Center="5.5,18.5" RadiusX="2.4" RadiusY="2.4" />
        <EllipseGeometry Center="18.5,5.5" RadiusX="2.4" RadiusY="2.4" />
        <PathGeometry Figures="M7.4,16.8 C10,14 13,10.5 16.8,7.3" />
        <PathGeometry Figures="M4,12.5 A9,9 0 0 1 12.5,4" />
    </GeometryGroup>

    <!-- Traffic: bar chart in a frame. -->
    <GeometryGroup x:Key="IconTraffic">
        <RectangleGeometry Rect="3,3,18,18" RadiusX="2.5" RadiusY="2.5" />
        <LineGeometry StartPoint="8,16" EndPoint="8,11" />
        <LineGeometry StartPoint="12,16" EndPoint="12,8" />
        <LineGeometry StartPoint="16,16" EndPoint="16,13" />
    </GeometryGroup>

    <!-- Alerts: bell. -->
    <GeometryGroup x:Key="IconAlerts">
        <PathGeometry Figures="M18,8.5 a6,6 0 1 0 -12,0 c0,6 -2,7.5 -2,7.5 h16 s-2,-1.5 -2,-7.5 z" />
        <PathGeometry Figures="M10.3,20 a2,2 0 0 0 3.4,0" />
    </GeometryGroup>

    <!-- Applications: a list with leading marks. -->
    <GeometryGroup x:Key="IconApplications">
        <LineGeometry StartPoint="10,6" EndPoint="21,6" />
        <LineGeometry StartPoint="10,12" EndPoint="21,12" />
        <LineGeometry StartPoint="10,18" EndPoint="21,18" />
        <LineGeometry StartPoint="3.5,6" EndPoint="6,6" />
        <LineGeometry StartPoint="3.5,12" EndPoint="6,12" />
        <LineGeometry StartPoint="3.5,18" EndPoint="6,18" />
    </GeometryGroup>

    <!-- Rules: a key. -->
    <GeometryGroup x:Key="IconRules">
        <PathGeometry Figures="M14.5,3.5 a4.5,4.5 0 0 0 -4.2,6.1 L3.5,16.4 V20 h3.6 l6.8,-6.8 a4.5,4.5 0 1 0 0.6,-9.7 z" />
    </GeometryGroup>

    <!-- Security: shield with a tick. -->
    <GeometryGroup x:Key="IconSecurity">
        <PathGeometry Figures="M12,21 s7.3,-3.7 7.3,-9.3 V5.4 L12,2.7 L4.7,5.4 v6.3 C4.7,17.3 12,21 12,21 z" />
        <PathGeometry Figures="M9,11.8 L11.3,14.1 L15.2,9.8" />
    </GeometryGroup>

    <!-- DNS resolver: globe. -->
    <GeometryGroup x:Key="IconDns">
        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
        <EllipseGeometry Center="12,12" RadiusX="4" RadiusY="9" />
        <LineGeometry StartPoint="3,12" EndPoint="21,12" />
    </GeometryGroup>

    <!-- Windows services: a device with a speaker slot. -->
    <GeometryGroup x:Key="IconServices">
        <RectangleGeometry Rect="7,2.5,10,19" RadiusX="2" RadiusY="2" />
        <LineGeometry StartPoint="10,6.5" EndPoint="14,6.5" />
    </GeometryGroup>

    <!-- Network scan: signal arcs over a point. -->
    <GeometryGroup x:Key="IconNetwork">
        <EllipseGeometry Center="12,15.5" RadiusX="2.6" RadiusY="2.6" />
        <PathGeometry Figures="M7.5,12.6 a7,7 0 0 1 9,0" />
        <PathGeometry Figures="M4.4,9.3 a11.5,11.5 0 0 1 15.2,0" />
    </GeometryGroup>

    <!-- Settings: cog. -->
    <GeometryGroup x:Key="IconSettings">
        <EllipseGeometry Center="12,12" RadiusX="3.2" RadiusY="3.2" />
        <PathGeometry Figures="M19.4,14.5 a1.6,1.6 0 0 0 0.3,1.8 2,2 0 1 1 -2.7,2.7 1.6,1.6 0 0 0 -2.7,1.1 2,2 0 1 1 -4,0 1.6,1.6 0 0 0 -2.7,-1.1 2,2 0 1 1 -2.7,-2.7 1.6,1.6 0 0 0 -1.1,-2.7 2,2 0 1 1 0,-4 1.6,1.6 0 0 0 1.1,-2.7 2,2 0 1 1 2.7,-2.7 1.6,1.6 0 0 0 2.7,-1.1 2,2 0 1 1 4,0 1.6,1.6 0 0 0 2.7,1.1 2,2 0 1 1 2.7,2.7 1.6,1.6 0 0 0 1.1,2.7 2,2 0 1 1 0,4 1.6,1.6 0 0 0 -1.4,1 z" />
    </GeometryGroup>

    <!-- ===================== Chrome ===================== -->

    <!-- Search. The top bar had a hand-written version of this; it is the
         design's, which sets the circle at r=7 centred on 11,11 rather than
         approximating it. -->
    <GeometryGroup x:Key="IconSearch">
        <EllipseGeometry Center="11,11" RadiusX="7" RadiusY="7" />
        <LineGeometry StartPoint="16,16" EndPoint="21,21" />
    </GeometryGroup>

    <!-- Device marker for the connection map: a monitor on a stand. Drawn rather
         than dotted because "where this machine appears to be" is a different
         KIND of thing from "where traffic went", and a dot in another colour only
         says that faintly. With a VPN running, this marker moving to another
         country is the confirmation the tunnel is up - and it staying put is the
         warning that it is not. -->
    <GeometryGroup x:Key="IconDevice">
        <RectangleGeometry Rect="2.5,4,19,12.5" RadiusX="2" RadiusY="2" />
        <LineGeometry StartPoint="12,16.5" EndPoint="12,20" />
        <LineGeometry StartPoint="8,20" EndPoint="16,20" />
    </GeometryGroup>

    <!-- Tick, used by verdict rows and confirmations. Left OPEN: this is a
         polyline in the source, and closing it would draw a triangle. -->
    <PathGeometry x:Key="IconCheck" Figures="M4,12.5 L9.5,18 L20,6.5" />

    <!-- Lockdown padlock, drawn for the posture module in 0.99.43. -->
    <PathGeometry x:Key="IconLock" Figures="M6.5,10.5 L17.5,10.5 A2,2 0 0 1 19.5,12.5 L19.5,18.5 A2,2 0 0 1 17.5,20.5 L6.5,20.5 A2,2 0 0 1 4.5,18.5 L4.5,12.5 A2,2 0 0 1 6.5,10.5 Z M8,10.5 V7.8 a4,4 0 0 1 8,0 v2.7" />

    <!-- Throughput arrows. -->
    <PathGeometry x:Key="IconArrowUp" Figures="M6,10 L12,4 L18,10 M12,4 L12,20" />
    <PathGeometry x:Key="IconArrowDown" Figures="M6,14 L12,20 L18,14 M12,20 L12,4" />

    <!-- Chevron, for the prompt's detail toggle. -->
    <PathGeometry x:Key="IconChevronDown" Figures="M6,9 L12,15 L18,9" />
    <PathGeometry x:Key="IconChevronUp" Figures="M6,15 L12,9 L18,15" />

    <!-- =====================================================================
         The presenter. A Viewbox around a fixed 24-unit canvas, so every icon
         is authored at one scale and drawn at whatever size the caller asks
         for, with the stroke scaling exactly as it does in SVG.

         Stroke colour is inherited from TextElement.Foreground on the way down
         rather than set here, so an icon sitting in a nav row takes that row's
         ink without anything having to repaint it - which also keeps it out of
         the binding-override trap, since nothing assigns it in code.
         ===================================================================== -->
    <Style x:Key="NavIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
