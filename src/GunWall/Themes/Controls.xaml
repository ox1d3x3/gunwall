<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ============================ Palette ============================ -->
    <!-- Theme-VARYING surfaces/text (BgPrimary, BgSecondary, BgCard,
         BgElevated, BorderBrush, TextPrimary, TextSecondary) live in the
         swappable Theme.Dark.xaml / Theme.Light.xaml dictionaries and are
         referenced with DynamicResource so they update live on theme switch.
         The accent, status, and gradient brushes below are theme-INVARIANT —
         the same cyan/violet identity works on both black and white. -->
    <!-- The action accent. Green because in this application the affirmative
         action is "allow", and the colour should agree with the verdict it
         produces. Hover and pressed are steps of the same hue rather than
         opacity changes, which stay legible on both themes. -->
    <!-- ===== No colour is defined in this file =====
         Eleven colours used to live here: a blue accent chain (#3A86E0 and its
         hover, pressed, second and gradient forms), two verdict literals, and a
         four-colour data series. All eleven predate the design handoff, none of
         them appears in either palette, and blue appears nowhere in this design
         at all - section 2 is explicit that red is the only decoratively used
         hue.

         They survived the palette rewrite in 0.99.32 for a simple reason: that
         release changed the palettes, and these were never IN the palettes. They
         sat in the shared dictionary keeping their old values while everything
         reading them carried on working. This is the same shape as the chart
         that stayed blue in 0.99.39 - a check confirming the palette changed
         says nothing about what is still reading somewhere else.

         Colour now has exactly one home: Theme.Dark.xaml and Theme.Light.xaml.
         A literal in this file is a defect by definition, and a check enforces
         that. If a value must invert between themes it belongs in the palettes;
         if it does not invert, it is not a colour.
         ============================================================== -->

    <!-- Prompt buttons. Muted and identical to each other on purpose: an
         interruption should not steer the answer, and a coloured button in a
         security prompt trains people to click the colour rather than read the
         label. Hover lifts slightly, pressed sinks. -->
        <!-- Deliberately identical to each other and quieter than the accent, so
         an interruption does not steer the answer. Fluent chrome underneath. -->
    <!-- PromptButton was removed in 0.99.44. It carried Padding="15,0" and was
         the reason a 34px details button clipped to a dot; its two consumers are
         now PromptSecondary and PromptPrimary, which state their own padding. -->

    <!-- Prompt actions, SPEC.md section 5: 36 high, radius 7, 12.5.
         Block is 'secondary' and Allow is 'primary' by weight only - both are
         ink on a quiet field, and neither is green or red. A green Allow beside
         a red Block turns a security decision into a reflex, and the reflex
         people learn is to press the coloured one. Closing the window blocks,
         so the safe answer is also the free one. -->
    <Style x:Key="PromptSecondary" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" Padding="15,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The prompt's detail chevron. Square, and its padding is stated here
         rather than inherited: the previous version was 34 wide against a shared
         style carrying Padding="15,0", which left four pixels for a twelve pixel
         glyph and rendered as a bare dot for several releases. -->
    <!-- Search result rows.

         With no style, ListBoxItem takes the control library's selection brush,
         which derives from our accent - so the highlighted row came out as a
         solid brand-red block with white text across it. That is the loudest
         thing the palette can produce, spent on "which row is the keyboard on".

         SPEC.md section 6 gives the answer for a selected row: 'brand-bg' fill
         with a 2px 'brand' inset on the leading edge. The tint carries the
         state and the bar carries the position, and 2px is reserved for exactly
         this family of markers. -->
    <!-- The search field.

         Setting BorderThickness="0" on the TextBox did not remove the red line
         under it: that line is not the TextBox's border. The control library's
         template draws its own focus underline as a separate element in the
         accent colour, and BorderThickness does not reach it - so the field
         showed a brand-red bar across the bottom, inside a box that already had
         a border of its own.

         The answer is not to fight the template but to replace it. A text field
         is a host for text; everything else here is drawn by the Border that
         wraps it. PART_ContentHost is the one name the TextBox contract
         requires - omit it and editing silently stops working while the control
         still renders.

         Scoped to this field rather than applied to every TextBox, because
         focus treatment across the app is 0.99.49's job and one field is not
         the place to decide it. -->
    <Style x:Key="SearchField" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BlockText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BlockFill}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchResultRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="2,0,0,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlockFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlockText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PromptChevron" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PromptPrimary" TargetType="Button" BasedOn="{StaticResource PromptSecondary}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" Padding="17,0"
                            Background="{DynamicResource BlockText}"
                            BorderBrush="{DynamicResource BlockText}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandHi}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Typefaces, SPEC.md section 3.

         Instrument Sans for everything, JetBrains Mono for every machine value -
         address, port, PID, MAC, hash, path, byte count, timestamp. Four weights
         and two respectively, shipped as static instances because WPF renders a
         variable font's default instance only: a SemiBold request against a
         variable file comes back Regular with no error to notice.

         The spec says no system fallback in shipping builds, and that is what is
         written here. The reasoning is that a silent fallback to Segoe UI is
         worse than a visible failure - the design's tight negative tracking at
         display sizes is set for these faces, and Segoe at the same values looks
         wrong rather than merely different. If a face fails to load it should be
         obvious, not quietly absorbed. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Instrument Sans</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>

    <!-- Type ramp, SPEC.md section 3. Body is 13 and table cells 12.5; the
         design never uppercases anything above 12px, and its tracking widens as
         the size drops - 0.09em at 11, 0.10em at 10.5, 0.12em for nav groups. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CaptionFontSize">11.5</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TableFontSize">12.5</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SubtitleFontSize">19</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TitleFontSize">34</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="StatFontSize">30</sys:Double>


    <!-- Handed over to WPF UI: ComboBox, ComboBoxItem, PasswordBox, TextBox,
         ContextMenu, MenuItem and Separator no longer have styles here.
         GunWall's dictionaries are merged after WPF UI's, so any style left in
         this file wins - which would have quietly cancelled the upgrade for
         exactly the controls it most improves.

         What stays is what carries a decision WPF UI cannot know about: the
         type ramp and colours on TextBlock, the list metrics the fixed-width
         columns depend on, and every keyed style (the navigation rail, cards,
         the firewall switch, the prompt buttons). -->

    <!-- The panel entrance lives in code (AnimatePanelIn), because it has to
         run on every navigation rather than once when the element loads. A
         Loaded-triggered style was defined here and never applied to anything,
         which is a quiet way to look animated while standing still. -->


    <!-- The library styles ScrollBar, ScrollViewer and ToolTip implicitly, and
         its ListView styles target its OWN ListView type rather than the
         framework one - so the lists here keep their styles, but take the
         library's state brushes and corner-radius token so a row and the
         controls beside it are drawn from the same values. Verified against
         Wpf.Ui/Controls/ListView and Resources/Variables.xaml. -->

    <!-- Removed as dead: SideNavIcon (superseded when the rail moved to Fluent
         SymbolIcons) and the TabButton/TabIcon/TabLabel trio (from a tab strip
         this window no longer has). Styles that nothing references are not
         harmless - they get maintained, copied and reasoned about as if they
         were live. -->

    <!-- Theme switch.

         The library's ToggleSwitch has no slot for an icon, and a bare switch
         beside two static icons only says "there are two options" - it does not
         say which one you are in. Here the icon rides inside the knob and the
         knob carries it across, so the control shows its current state rather
         than its available states.

         Motion follows the same convention as the rest of the interface: the
         knob travels in 167ms on a decelerating curve, and the two icons cross
         over it in 80ms so the swap lands before the knob settles rather than
         after it, which would read as a lag. -->
    <!-- Theme control, SPEC.md section 1: a 30x30 icon button, not a switch.

         It was a 52x28 sliding pill with the sun/moon riding inside the knob.
         That reads as a setting with two equal states, which is what a switch
         means - but a theme is not on-or-off, and the pill was the widest object
         in a 54px bar built around quiet readouts. A round button showing the
         theme you would GET on pressing it says the same thing in a third of the
         width and stops competing with the throughput figures beside it.

         Still a ToggleButton so IsChecked keeps its meaning for the handler:
         checked = light. -->
    <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Fill="Transparent" />
                        <!-- Moon: a disc with a second disc punched out of it, so
                             the crescent is geometry rather than a glyph and takes
                             the theme ink like everything else. Shown while dark
                             is active, since pressing gives you light. -->
                        <Path x:Name="MoonIcon" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource TextSecondary}"
                              Data="M12,3 A9,9 0 1 0 21,12 A7,7 0 1 1 12,3 Z" />
                        <!-- Sun: disc plus eight rays. -->
                        <Path x:Name="SunIcon" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7 M12,1 L12,3.5
                                    M12,20.5 L12,23 M4.2,4.2 L6,6 M18,18 L19.8,19.8
                                    M1,12 L3.5,12 M20.5,12 L23,12 M4.2,19.8 L6,18
                                    M18,6 L19.8,4.2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MoonIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SunIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data cells: addresses, ports, process identifiers, byte counts.
         Tabular figures are the point - every digit takes the same width, so a
         column of addresses lines up and a number that changes does not make the
         row jump. -->
    <Style x:Key="DataCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ======================= Base TextBlock ======================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========================= Card border ========================= -->
        <!-- Cards take the library's own tokens rather than restating a surface
         colour, so a card and the controls sitting on it are drawn from one
         source and cannot drift apart.

         The border brightens on hover with a plain trigger, not an animation.
         An animation here would have to target the BorderBrush's opacity - but
         that brush is a shared application resource, so animating it would move
         every card in the window at once, and would throw outright if the brush
         is frozen. A Border style cannot introduce an overlay layer to fade
         instead, the way the navigation template does, so the honest answer is
         an instant state change rather than a broken smooth one. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The NavButton style was removed in 0.99.42. It styled the old Fluent
         navigation rail, which the 238px grouped sidebar replaced in 0.99.33;
         nothing has referenced it since. It is called out here rather than
         deleted silently because it is what the blue accent chain was still
         being kept alive for - a dead style holding a dead colour, each
         justifying the other. -->


    <!-- ===================== Slide on/off toggle ===================== -->
    <!-- A CheckBox rendered as an animated pill switch: gray when off, green
         when on, with a thumb that slides across. IsChecked / Click behave
         exactly like a normal CheckBox. -->
    <!-- SlideToggle removed: every switch in this application is now the
         library's ToggleSwitch, so a hand-templated CheckBox pretending to be
         one served no purpose except to drift away from it. -->


    <!-- ===================== Animated theme switch ===================== -->
    <!-- A pill toggle with a thumb that slides between the two ends, animated.
         Checked = light theme, Unchecked = dark theme. Sun/moon glyphs sit on
         each end so the meaning is clear in both states. -->
    <!-- ThemeSwitch removed for the same reason as SlideToggle: the theme
         control is now the library's ToggleSwitch, like every other switch. -->


    <!-- ======================= Top tab button =======================
         Modern style: a Segoe icon glyph above the label, with a soft
         rounded tinted highlight on the active tab (no underline). The icon
         glyph is supplied per-tab via the Tag-adjacent IconGlyph attached
         text; here we render whatever the RadioButton's content provides. -->

    <!-- Tab icon glyph (Segoe Fluent / MDL2) -->


    <!-- ===================== Sidebar navigation ===================== -->
        <!-- Restated so they resolve at parse time no matter the merge order.
         Values are the library's own (NavigationViewConstants.xaml). -->
    <!-- The library's own value is 60, sized for a rail of half a dozen
         items. GunWall has thirteen, which needs 806 pixels of height and put
         four tabs off-screen behind a scrollbar. 48 fits them all in a normal
         window; navigation you cannot see is worse than a tile that is not
         exactly to spec. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PaneFluentButtonHeight">48</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PaneFluentButtonWidth">60</sys:Double>

    <!-- Navigation row, from SPEC.md section 5.

         The rail is 238px and the rows are horizontal: icon, label, and an
         optional count on the right. The tile arrangement this replaced came
         from an earlier reading of the design; the handoff is explicit that the
         sidebar is wide and grouped under headings.

         The selection marker is a 2 by 16 rounded rect at x -12, which puts it
         OUTSIDE the row's padding box, in the sidebar gutter. The spec calls
         that out specifically - it is not a left border on the row, and drawing
         it as one would sit it inside the rounded corner and clip.

         Motion is the spec's: 120ms for the hover tint, 150ms for the marker
         growing from nothing to its full height. -->
    <Style x:Key="SideNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="tint" CornerRadius="7" Opacity="0"
                                Background="{DynamicResource SurfaceHover}" />
                        <Rectangle x:Name="marker" Width="2" Height="0"
                                   RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="-12,0,0,0"
                                   Fill="{DynamicResource BlockText}" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="marker"
                                                         Storyboard.TargetProperty="Height"
                                                         To="16" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="marker"
                                                         Storyboard.TargetProperty="Height"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group heading above each run of nav rows. Uppercase, widely tracked and
         in metadata grey, so it separates without competing. -->
    <Style x:Key="NavGroupHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="Margin" Value="8,16,8,7" />
    </Style>

    <!-- Row label. No trimming cap: at 238px wide these fit, which is most of
         the reason the design uses a wide rail. -->
    <Style x:Key="SideNavLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>



    <!-- ======================= Primary button ======================= -->
    
    <!-- The accent button, entirely on the library's own accent brushes.

         This previously set Foreground to white, which is what made it look
         washed out: Fluent LIGHTENS the accent for a dark theme so it stands
         off a dark surface, then pairs it with BLACK text
         (TextOnAccentFillColorPrimary is #000000 in dark, #FFFFFF in light).
         White lettering on a lightened accent has almost no contrast, and no
         amount of retuning the seed colour fixes that - the foreground was the
         wrong half of the pair. Taking both from the library keeps them in step
         in either theme. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <!-- Painted from GunWall's own brand token rather than the library's
             accent chain. That chain derives a lighter, desaturated variant for
             dark themes, which is right for chrome and wrong for a filled
             button - it was rendering the primary action as pale salmon. The
             design specifies one accent with white on it, so this states both
             rather than hoping the derivation lands there. -->
        <Setter Property="Background" Value="{DynamicResource BlockText}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BlockText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <!-- The spec's hover and pressed are brightness shifts on the same
                 fill, not different colours. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.76" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================= Action button ======================= -->
        <!-- The standard Fluent button, unaltered apart from a shared height so
         rows of controls line up. -->
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- The lockdown button in the posture module. Templated rather than derived
         from the library button because it has to invert completely when engaged:
         quiet field at rest, solid brand while lockdown holds. Setters first,
         triggers last - MC3088.

         Note IsHitTestVisible is left alone. An earlier version of this control
         disabled itself while engaged, which meant the only way out of lockdown
         was the tray menu. A button that gets you into a state must get you out
         of it. -->
    <Style x:Key="PostureButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Engaged">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BlockText}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlockText}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Scrollbars, SPEC.md section 12: thin, thumb only, no track, no arrows.

         The library default is a Fluent scrollbar with stepper buttons and a
         filled track. In a window whose whole visual argument is hairlines and
         quiet surfaces, that is the loudest chrome on screen, and it is attached
         to the thing you are least interested in looking at.

         The thumb is 'line2' at rest and 't3' under the pointer - the same two
         values the table hairlines use, so a scrollbar reads as part of the
         frame rather than as a control sitting on top of it.
         ===================================================================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="3" Margin="2"
                            Background="{DynamicResource BorderBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource TextTertiary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- No RepeatButtons. A stepper arrow is a 20px target that
                         moves the view by one line; it costs both ends of every
                         scrollbar in the application and earns neither. -->
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Focus, SPEC.md section 12: a 2px 'brand' ring.

         WPF's default focus visual is a dotted rectangle inherited from Win32,
         which in this design reads as a rendering fault rather than as focus.

         FocusVisualStyle is the right hook specifically because WPF applies it
         for KEYBOARD focus and not for a mouse click. A ring drawn on the button
         you just clicked tells you something you already know, and that is the
         thing that makes people want focus indicators switched off.

         2px is the reserved measure - the same as a selected table row and the
         nav marker. Nothing else in this design is 2px, which is what lets the
         width alone carry the meaning.
         ===================================================================== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2" RadiusX="8" RadiusY="8"
                               Stroke="{DynamicResource BlockText}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =====================================================================
         Tables, SPEC.md sections 6 and 12.

         Ten screens share these three styles, so the whole table language lives
         here rather than being restated per panel.

         WHAT CHANGED AND WHY

         The old rows were rounded cards with a one pixel gap between them, hover
         from a control-library brush, and a selection tint that was the SAME
         value as nav hover. The design is flatter and quieter than that: rows
         are separated by a hairline, not by air; they have no radius; and
         selection is a brand tint with a two pixel bar on the leading edge.

         The distinction the old version lost is worth naming. Hover is where the
         pointer happens to be. Selection is a decision. When both are the same
         value you cannot tell, in a screenshot or at a glance, which row you
         chose - and on a firewall the selected row is the one whose rule you are
         about to change. 'row-hover' is deliberately half the strength of
         'hover' so the pointer is felt rather than announced, and selection is
         the only one of the two that gets colour.

         Two pixels on the leading edge is a reserved measure in this design -
         focus ring, nav marker, radio ring, selected row. Nothing else is 2px,
         which is what makes it read as "this one" rather than as decoration.
         ===================================================================== -->
    <!-- The empty state, SPEC.md section 10.

         A table with nothing in it used to render as a header rule over blank
         space, which reads as "still loading" or "something broke" rather than
         "there is nothing here yet" - and on several of these screens an empty
         table is the NORMAL, good condition. No rules is what a fresh install
         looks like. No alerts is what a quiet day looks like.

         The message comes from the ListView's Tag so one template serves all ten
         tables without a per-screen subclass, and it is driven by HasItems
         rather than by a count kept in code, which cannot drift out of step with
         what is actually on screen.

         Skeleton and error states are not here yet. They need to distinguish
         "loading", "failed" and "genuinely empty", which is a state machine
         rather than a trigger, and guessing wrong shows "nothing here" over a
         table that simply has not finished loading. -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Grid>
                        <!-- This ScrollViewer style is NOT optional and NOT cosmetic.
                             When a ListView has a GridView, the column header row is
                             drawn by a GridViewHeaderRowPresenter that lives inside
                             the ScrollViewer's template, supplied by this key.
                             Replacing the ListView template without it produces a
                             table that renders its rows perfectly and has no headers
                             at all - which looks like a layout bug rather than a
                             missing style, and would be hunted for in the wrong
                             place entirely. -->
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                      Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                            <ItemsPresenter SnapsToDevicePixels="True" />
                        </ScrollViewer>
                        <TextBlock x:Name="empty" Text="{TemplateBinding Tag}"
                                   Visibility="Collapsed" FontSize="13" Margin="0,42,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextTertiary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasItems" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="empty" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column headers: 10.5/600 in 't3', on a 'line2' rule.

         No hover state. The old one lit the header background on pointer-over,
         which promises sorting - and most of these columns do not sort. An
         affordance that does nothing is worse than no affordance.

         't3' is correct here specifically BECAUSE the design says nothing needed
         to make a decision may be 't3': a column header names the data, it is
         not the data. The values below it carry the weight. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="hb" Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="10,0,10,10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                          TextElement.Foreground="{DynamicResource TextTertiary}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rows: hairline-separated, square, 'row-hover' on pointer, 'brand-bg'
         with a 2px 'brand' inset when selected.

         BorderThickness carries both the separator and the selection bar, so a
         selected row does not change height - a row that grows on selection
         shifts every row beneath it, which on a live table that is also
         inserting rows reads as the list jumping. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource TableFontSize}" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Border x:Name="sel" BorderBrush="Transparent" BorderThickness="2,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <!-- Selection is a decision; hover is where the pointer is.
                             They must not look alike. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BlockFill}" />
                            <Setter TargetName="sel" Property="BorderBrush" Value="{DynamicResource BlockText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Themed ComboBox ===================== -->
    
    
    <!-- ===================== Themed TextBox ===================== -->
    
    
    <!-- ===================== Themed context menu ===================== -->
    
    
    
</ResourceDictionary>
