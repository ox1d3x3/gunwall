<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ============================ Palette ============================ -->
    <!-- Theme-VARYING surfaces/text (BgPrimary, BgSecondary, BgCard,
         BgElevated, BorderBrush, TextPrimary, TextSecondary) live in the
         swappable Theme.Dark.xaml / Theme.Light.xaml dictionaries and are
         referenced with DynamicResource so they update live on theme switch.
         The accent, status, and gradient brushes below are theme-INVARIANT —
         the same cyan/violet identity works on both black and white. -->
    <!-- The action accent. Green because in this application the affirmative
         action is "allow", and the colour should agree with the verdict it
         produces. Hover and pressed are steps of the same hue rather than
         opacity changes, which stay legible on both themes. -->
    <!-- Green was doing two unrelated jobs: it marked the primary action AND it
         meant "allowed". That is why the interface reads as noisy - the same
         colour appears on a button you should press and on a verdict you should
         notice, and neither is clearly either. Fluent separates them, and so do
         we now: blue carries interaction (selection, focus, the primary action),
         green and red stay reserved for what a firewall actually decides. -->
    <Color x:Key="AccentColor">#3A86E0</Color>
    <Color x:Key="Accent2Color">#3A86E0</Color>

    <SolidColorBrush x:Key="Accent"         Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2"        Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="AccentHover"    Color="#4C97EE" />
    <SolidColorBrush x:Key="AccentPressed"  Color="#2C6EBF" />

    <SolidColorBrush x:Key="AllowBrush" Color="#34D164" />
    <SolidColorBrush x:Key="BlockBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="InboundBrush" Color="#4DA3FF" />
    <SolidColorBrush x:Key="OutboundBrush" Color="#E066A6" />

    <!-- Data series. Charts and legend dots draw from these rather than
         restating hex values, so the palette is one place and a series can be
         retuned without hunting through the window. Ordered by how often a
         reading eye meets them: allowed, warning, information, blocked. -->
    <SolidColorBrush x:Key="Series1" Color="#34D164" />
    <SolidColorBrush x:Key="Series2" Color="#FFB020" />
    <SolidColorBrush x:Key="Series3" Color="#4DA3FF" />
    <SolidColorBrush x:Key="Series4" Color="#FF453A" />

    <!-- Flat accent (kept as a 'gradient' key name for compatibility, but solid
         for a clean, professional, non-AI look). -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A86E0" Offset="0" />
        <GradientStop Color="#2C6EBF" Offset="1" />
    </LinearGradientBrush>

    <!-- Prompt buttons. Muted and identical to each other on purpose: an
         interruption should not steer the answer, and a coloured button in a
         security prompt trains people to click the colour rather than read the
         label. Hover lifts slightly, pressed sinks. -->
        <!-- Deliberately identical to each other and quieter than the accent, so
         an interruption does not steer the answer. Fluent chrome underneath. -->
    <Style x:Key="PromptButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Typefaces, SPEC.md section 3.

         Instrument Sans for everything, JetBrains Mono for every machine value -
         address, port, PID, MAC, hash, path, byte count, timestamp. Four weights
         and two respectively, shipped as static instances because WPF renders a
         variable font's default instance only: a SemiBold request against a
         variable file comes back Regular with no error to notice.

         The spec says no system fallback in shipping builds, and that is what is
         written here. The reasoning is that a silent fallback to Segoe UI is
         worse than a visible failure - the design's tight negative tracking at
         display sizes is set for these faces, and Segoe at the same values looks
         wrong rather than merely different. If a face fails to load it should be
         obvious, not quietly absorbed. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Instrument Sans</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono</FontFamily>

    <!-- Type ramp, SPEC.md section 3. Body is 13 and table cells 12.5; the
         design never uppercases anything above 12px, and its tracking widens as
         the size drops - 0.09em at 11, 0.10em at 10.5, 0.12em for nav groups. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CaptionFontSize">11.5</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyStrongFontSize">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TableFontSize">12.5</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SubtitleFontSize">19</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TitleFontSize">34</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="StatFontSize">30</sys:Double>


    <!-- Handed over to WPF UI: ComboBox, ComboBoxItem, PasswordBox, TextBox,
         ContextMenu, MenuItem and Separator no longer have styles here.
         GunWall's dictionaries are merged after WPF UI's, so any style left in
         this file wins - which would have quietly cancelled the upgrade for
         exactly the controls it most improves.

         What stays is what carries a decision WPF UI cannot know about: the
         type ramp and colours on TextBlock, the list metrics the fixed-width
         columns depend on, and every keyed style (the navigation rail, cards,
         the firewall switch, the prompt buttons). -->

    <!-- The panel entrance lives in code (AnimatePanelIn), because it has to
         run on every navigation rather than once when the element loads. A
         Loaded-triggered style was defined here and never applied to anything,
         which is a quiet way to look animated while standing still. -->


    <!-- The library styles ScrollBar, ScrollViewer and ToolTip implicitly, and
         its ListView styles target its OWN ListView type rather than the
         framework one - so the lists here keep their styles, but take the
         library's state brushes and corner-radius token so a row and the
         controls beside it are drawn from the same values. Verified against
         Wpf.Ui/Controls/ListView and Resources/Variables.xaml. -->

    <!-- Removed as dead: SideNavIcon (superseded when the rail moved to Fluent
         SymbolIcons) and the TabButton/TabIcon/TabLabel trio (from a tab strip
         this window no longer has). Styles that nothing references are not
         harmless - they get maintained, copied and reasoned about as if they
         were live. -->

    <!-- Theme switch.

         The library's ToggleSwitch has no slot for an icon, and a bare switch
         beside two static icons only says "there are two options" - it does not
         say which one you are in. Here the icon rides inside the knob and the
         knob carries it across, so the control shows its current state rather
         than its available states.

         Motion follows the same convention as the rest of the interface: the
         knob travels in 167ms on a decelerating curve, and the two icons cross
         over it in 80ms so the swap lands before the knob settles rather than
         after it, which would read as a lag. -->
    <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                            BorderThickness="1">
                        <Canvas>
                            <Border x:Name="knob" Width="22" Height="22" CornerRadius="11"
                                    Canvas.Top="2" Canvas.Left="2"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}">
                                <Grid>
                                    <!-- Both icons live in the knob; only one is
                                         ever visible, so the swap is a crossfade
                                         rather than two elements moving. -->
                                    <ui:SymbolIcon x:Name="moon" Symbol="WeatherMoon24"
                                                   FontSize="13" Opacity="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ApplicationBackgroundBrush}" />
                                    <ui:SymbolIcon x:Name="sun" Symbol="WeatherSunny24"
                                                   FontSize="13" Opacity="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ApplicationBackgroundBrush}" />
                                </Grid>
                            </Border>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="knob"
                                                         Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="26" Duration="0:0:0.167"
                                                         DecelerationRatio="0.7" />
                                        <DoubleAnimation Storyboard.TargetName="sun"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="moon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="knob"
                                                         Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="2" Duration="0:0:0.167"
                                                         DecelerationRatio="0.7" />
                                        <DoubleAnimation Storyboard.TargetName="sun"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="moon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Background"
                                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data cells: addresses, ports, process identifiers, byte counts.
         Tabular figures are the point - every digit takes the same width, so a
         column of addresses lines up and a number that changes does not make the
         row jump. -->
    <Style x:Key="DataCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ======================= Base TextBlock ======================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========================= Card border ========================= -->
        <!-- Cards take the library's own tokens rather than restating a surface
         colour, so a card and the controls sitting on it are drawn from one
         source and cannot drift apart.

         The border brightens on hover with a plain trigger, not an animation.
         An animation here would have to target the BorderBrush's opacity - but
         that brush is a shared application resource, so animating it would move
         every card in the window at once, and would throw outright if the brush
         is frozen. A Border style cannot introduce an overlay layer to fade
         instead, the way the navigation template does, so the honest answer is
         an instant state change rather than a broken smooth one. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Navigation button ===================== -->
    <!-- Navigation rail, on Fluent NavigationView proportions.

         Selected and hover both painted themselves with the card colour, so
         pointing at an item looked exactly like having chosen it - the one
         thing a navigation list has to make obvious. They are now distinct
         surfaces, and the selected indicator is a short centred pill rather
         than a full-height bar, which is what stops the rail reading as a
         stack of tabs. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Border>
                        <!-- A short pill, vertically centred, as Fluent draws it -->
                        <Rectangle x:Name="bar" Width="3" Height="16"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="0" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slide on/off toggle ===================== -->
    <!-- A CheckBox rendered as an animated pill switch: gray when off, green
         when on, with a thumb that slides across. IsChecked / Click behave
         exactly like a normal CheckBox. -->
    <!-- SlideToggle removed: every switch in this application is now the
         library's ToggleSwitch, so a hand-templated CheckBox pretending to be
         one served no purpose except to drift away from it. -->


    <!-- ===================== Animated theme switch ===================== -->
    <!-- A pill toggle with a thumb that slides between the two ends, animated.
         Checked = light theme, Unchecked = dark theme. Sun/moon glyphs sit on
         each end so the meaning is clear in both states. -->
    <!-- ThemeSwitch removed for the same reason as SlideToggle: the theme
         control is now the library's ToggleSwitch, like every other switch. -->


    <!-- ======================= Top tab button =======================
         Modern style: a Segoe icon glyph above the label, with a soft
         rounded tinted highlight on the active tab (no underline). The icon
         glyph is supplied per-tab via the Tag-adjacent IconGlyph attached
         text; here we render whatever the RadioButton's content provides. -->

    <!-- Tab icon glyph (Segoe Fluent / MDL2) -->


    <!-- ===================== Sidebar navigation ===================== -->
        <!-- Restated so they resolve at parse time no matter the merge order.
         Values are the library's own (NavigationViewConstants.xaml). -->
    <!-- The library's own value is 60, sized for a rail of half a dozen
         items. GunWall has thirteen, which needs 806 pixels of height and put
         four tabs off-screen behind a scrollbar. 48 fits them all in a normal
         window; navigation you cannot see is worse than a tile that is not
         exactly to spec. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PaneFluentButtonHeight">48</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PaneFluentButtonWidth">60</sys:Double>

    <!-- Navigation row, from SPEC.md section 5.

         The rail is 238px and the rows are horizontal: icon, label, and an
         optional count on the right. The tile arrangement this replaced came
         from an earlier reading of the design; the handoff is explicit that the
         sidebar is wide and grouped under headings.

         The selection marker is a 2 by 16 rounded rect at x -12, which puts it
         OUTSIDE the row's padding box, in the sidebar gutter. The spec calls
         that out specifically - it is not a left border on the row, and drawing
         it as one would sit it inside the rounded corner and clip.

         Motion is the spec's: 120ms for the hover tint, 150ms for the marker
         growing from nothing to its full height. -->
    <Style x:Key="SideNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="tint" CornerRadius="7" Opacity="0"
                                Background="{DynamicResource SurfaceHover}" />
                        <Rectangle x:Name="marker" Width="2" Height="0"
                                   RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="-12,0,0,0"
                                   Fill="{DynamicResource BlockText}" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="marker"
                                                         Storyboard.TargetProperty="Height"
                                                         To="16" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tint"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="marker"
                                                         Storyboard.TargetProperty="Height"
                                                         To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group heading above each run of nav rows. Uppercase, widely tracked and
         in metadata grey, so it separates without competing. -->
    <Style x:Key="NavGroupHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="Margin" Value="8,16,8,7" />
    </Style>

    <!-- Row label. No trimming cap: at 238px wide these fit, which is most of
         the reason the design uses a wide rail. -->
    <Style x:Key="SideNavLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>



    <!-- ======================= Primary button ======================= -->
    
    <!-- The accent button, entirely on the library's own accent brushes.

         This previously set Foreground to white, which is what made it look
         washed out: Fluent LIGHTENS the accent for a dark theme so it stands
         off a dark surface, then pairs it with BLACK text
         (TextOnAccentFillColorPrimary is #000000 in dark, #FFFFFF in light).
         White lettering on a lightened accent has almost no contrast, and no
         amount of retuning the seed colour fixes that - the foreground was the
         wrong half of the pair. Taking both from the library keeps them in step
         in either theme. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <!-- Painted from GunWall's own brand token rather than the library's
             accent chain. That chain derives a lighter, desaturated variant for
             dark themes, which is right for chrome and wrong for a filled
             button - it was rendering the primary action as pale salmon. The
             design specifies one accent with white on it, so this states both
             rather than hoping the derivation lands there. -->
        <Setter Property="Background" Value="{DynamicResource BlockText}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BlockText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <!-- The spec's hover and pressed are brightness shifts on the same
                 fill, not different colours. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.76" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================= Action button ======================= -->
        <!-- The standard Fluent button, unaltered apart from a shared height so
         rows of controls line up. -->
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================== List view styling ===================== -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="hb" Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource BgElevated}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium list rows: rounded, hover highlight, accent selection bar. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                        </Trigger>
                        <!-- Selection is a different surface from hover: a row you are
                             pointing at and a row you have chosen must not look alike. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
