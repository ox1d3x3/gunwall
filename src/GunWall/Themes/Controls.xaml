<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Palette ============================ -->
    <!-- Theme-VARYING surfaces/text (BgPrimary, BgSecondary, BgCard,
         BgElevated, BorderBrush, TextPrimary, TextSecondary) live in the
         swappable Theme.Dark.xaml / Theme.Light.xaml dictionaries and are
         referenced with DynamicResource so they update live on theme switch.
         The accent, status, and gradient brushes below are theme-INVARIANT —
         the same cyan/violet identity works on both black and white. -->
    <!-- The action accent. Green because in this application the affirmative
         action is "allow", and the colour should agree with the verdict it
         produces. Hover and pressed are steps of the same hue rather than
         opacity changes, which stay legible on both themes. -->
    <!-- Green was doing two unrelated jobs: it marked the primary action AND it
         meant "allowed". That is why the interface reads as noisy - the same
         colour appears on a button you should press and on a verdict you should
         notice, and neither is clearly either. Fluent separates them, and so do
         we now: blue carries interaction (selection, focus, the primary action),
         green and red stay reserved for what a firewall actually decides. -->
    <Color x:Key="AccentColor">#3A86E0</Color>
    <Color x:Key="Accent2Color">#3A86E0</Color>

    <SolidColorBrush x:Key="Accent"         Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2"        Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="AccentHover"    Color="#4C97EE" />
    <SolidColorBrush x:Key="AccentPressed"  Color="#2C6EBF" />

    <SolidColorBrush x:Key="AllowBrush" Color="#34D164" />
    <SolidColorBrush x:Key="BlockBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="InboundBrush" Color="#4DA3FF" />
    <SolidColorBrush x:Key="OutboundBrush" Color="#E066A6" />

    <!-- Data series. Charts and legend dots draw from these rather than
         restating hex values, so the palette is one place and a series can be
         retuned without hunting through the window. Ordered by how often a
         reading eye meets them: allowed, warning, information, blocked. -->
    <SolidColorBrush x:Key="Series1" Color="#34D164" />
    <SolidColorBrush x:Key="Series2" Color="#FFB020" />
    <SolidColorBrush x:Key="Series3" Color="#4DA3FF" />
    <SolidColorBrush x:Key="Series4" Color="#FF453A" />

    <!-- Flat accent (kept as a 'gradient' key name for compatibility, but solid
         for a clean, professional, non-AI look). -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A86E0" Offset="0" />
        <GradientStop Color="#2C6EBF" Offset="1" />
    </LinearGradientBrush>

    <!-- Prompt buttons. Muted and identical to each other on purpose: an
         interruption should not steer the answer, and a coloured button in a
         security prompt trains people to click the colour rather than read the
         label. Hover lifts slightly, pressed sinks. -->
    <SolidColorBrush x:Key="PromptButtonBg"        Color="#7C8CA6" />
    <SolidColorBrush x:Key="PromptButtonBgHover"   Color="#8B9BB4" />
    <SolidColorBrush x:Key="PromptButtonBgPressed" Color="#6B7A93" />

        <!-- Deliberately identical to each other and quieter than the accent, so
         an interruption does not steer the answer. Fluent chrome underneath. -->
    <Style x:Key="PromptButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- Type ramp. There were nine font sizes in this file with no relationship
         to one another - 11, 11.5, 12, 12.5, 13, 14, 16, 18, 24 - which is what
         makes text look placed rather than set. These are Fluent's steps, named
         so a new control picks one instead of inventing another.

         Body stays at 13 rather than Fluent's 14 on purpose: the lists here have
         fixed column widths, and widening the text without re-measuring every
         column would truncate names. That is a deliberate deviation, not an
         oversight. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyFontSize">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="BodyStrongFontSize">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SubtitleFontSize">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="TitleFontSize">28</sys:Double>

    <!-- Handed over to WPF UI: ComboBox, ComboBoxItem, PasswordBox, TextBox,
         ContextMenu, MenuItem and Separator no longer have styles here.
         GunWall's dictionaries are merged after WPF UI's, so any style left in
         this file wins - which would have quietly cancelled the upgrade for
         exactly the controls it most improves.

         What stays is what carries a decision WPF UI cannot know about: the
         type ramp and colours on TextBlock, the list metrics the fixed-width
         columns depend on, and every keyed style (the navigation rail, cards,
         the firewall switch, the prompt buttons). -->

    <!-- Panel entrance, matched to the library's FadeInWithSlide.
         Its values, from TransitionAnimationProvider: translate from 30 to 0
         with DecelerationRatio 0.7, opacity 0 to 1, same duration for both.
         A deceleration ratio is not the same as an easing function - it front-
         loads the movement so content arrives and settles, which is why an
         approximation with CubicEase read differently. -->
    <Style x:Key="PanelTransition" TargetType="ContentControl">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.2"
                                         DecelerationRatio="0.7" />
                        <DoubleAnimation
                            Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                            From="30" To="0" Duration="0:0:0.2"
                            DecelerationRatio="0.7" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- The library styles ScrollBar, ScrollViewer and ToolTip implicitly, and
         its ListView styles target its OWN ListView type rather than the
         framework one - so the lists here keep their styles, but take the
         library's state brushes and corner-radius token so a row and the
         controls beside it are drawn from the same values. Verified against
         Wpf.Ui/Controls/ListView and Resources/Variables.xaml. -->

    <!-- ======================= Base TextBlock ======================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========================= Card border ========================= -->
        <!-- Uses the control library's own card tokens rather than restating a
         surface colour, so a card and the controls sitting on it are drawn from
         the same source and cannot drift apart. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Navigation button ===================== -->
    <!-- Navigation rail, on Fluent NavigationView proportions.

         Selected and hover both painted themselves with the card colour, so
         pointing at an item looked exactly like having chosen it - the one
         thing a navigation list has to make obvious. They are now distinct
         surfaces, and the selected indicator is a short centred pill rather
         than a full-height bar, which is what stops the rail reading as a
         stack of tabs. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Border>
                        <!-- A short pill, vertically centred, as Fluent draws it -->
                        <Rectangle x:Name="bar" Width="3" Height="16"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="0" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slide on/off toggle ===================== -->
    <!-- A CheckBox rendered as an animated pill switch: gray when off, green
         when on, with a thumb that slides across. IsChecked / Click behave
         exactly like a normal CheckBox. -->
    <Style x:Key="SlideToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" CornerRadius="12"
                            Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border x:Name="thumb" Width="18" Height="18" CornerRadius="8"
                                Background="{DynamicResource TextSecondary}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="thumbShift" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource AllowBrush}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AllowBrush}" />
                            <Setter TargetName="thumb" Property="Background" Value="#FFFFFF" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="22" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Animated theme switch ===================== -->
    <!-- A pill toggle with a thumb that slides between the two ends, animated.
         Checked = light theme, Unchecked = dark theme. Sun/moon glyphs sit on
         each end so the meaning is clear in both states. -->
    <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="12"
                            Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="&#x263E;" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" />
                            <TextBlock Text="&#x2600;" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <Border x:Name="thumb" Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource AccentGradient}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="thumbShift" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="28" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="thumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Top tab button =======================
         Modern style: a Segoe icon glyph above the label, with a soft
         rounded tinted highlight on the active tab (no underline). The icon
         glyph is supplied per-tab via the Tag-adjacent IconGlyph attached
         text; here we render whatever the RadioButton's content provides. -->
    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                            Padding="14,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgElevated}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab icon glyph (Segoe Fluent / MDL2) -->
    <Style x:Key="TabIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="TabLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
    </Style>

    <!-- ===================== Sidebar navigation ===================== -->
        <!-- Restated so they resolve at parse time no matter the merge order.
         Values are the library's own (NavigationViewConstants.xaml). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PaneFluentButtonHeight">60</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="PaneFluentButtonWidth">60</sys:Double>

    <!-- Navigation item, on the library's LeftFluent specification.
         Values read from NavigationLeftFluent.xaml and NavigationViewConstants
         rather than estimated: item 60 by 60, icon 24, label beneath, selection
         indicator 3 by 24 in the pane gutter.

         The earlier version of this style used the STANDARD NavigationViewItem
         metrics - a 36-pixel row with the icon beside the label. Both are real
         parts of the library, but the Fluent gallery uses LeftFluent, which is
         why matching the other one did not look like the thing being pointed
         at. A rail of icon tiles also gives roughly 120 pixels back to the
         content, which is what lets the window material show.

         Selection is signalled twice on purpose - a filled background AND an
         accent-coloured icon - which is how the library does it and why its
         selected item reads instantly. -->
    <Style x:Key="SideNavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForegroundLeftFluent}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="{StaticResource PaneFluentButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource PaneFluentButtonHeight}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Rectangle x:Name="bar" Width="3" Height="24"
                                   Margin="-6,0,0,0" RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                   Visibility="Collapsed" />
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}" />
                            <Setter TargetName="cp" Property="TextElement.Foreground"
                                    Value="{DynamicResource NavigationViewItemForegroundPointerOverLeftFluent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource NavigationViewItemBackgroundSelectedLeftFluent}" />
                            <Setter TargetName="cp" Property="TextElement.Foreground"
                                    Value="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Label beneath the icon: small, centred, and allowed to shrink rather
         than clip, since a 60-pixel tile is narrower than some of these words. -->
    <Style x:Key="SideNavLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="58" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SideNavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Width" Value="22" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
    </Style>


    <!-- ======================= Primary button ======================= -->
    
    <!-- Derived from WPF UI's button rather than replacing it: the Fluent
         chrome - corner radius, focus visual, the faint top highlight, the
         pressed and disabled states - all comes from their template. We set
         only what makes it OURS, which is the accent fill. Replacing the
         template outright is what kept this application looking unchanged
         after the library was added. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackgroundPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================= Action button ======================= -->
        <!-- The standard Fluent button, unaltered apart from a shared height so
         rows of controls line up. -->
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- ===================== List view styling ===================== -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="hb" Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource BgElevated}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Premium list rows: rounded, hover highlight, accent selection bar. -->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                        </Trigger>
                        <!-- Selection is a different surface from hover: a row you are
                             pointing at and a row you have chosen must not look alike. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
