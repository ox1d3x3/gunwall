<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== DARK THEME =====
         These are aliases, not a palette.

         GunWall's own surface and text tokens are referenced 115 times across
         the window and the control styles, against 18 references to the control
         library's. That ratio is why the interface kept reading as its old self
         after the library was adopted: the library was styling the controls
         while GunWall was still painting everything around them, so the two
         never agreed. Redefining these as pointers to the library's own brushes
         makes all 115 call sites resolve to its colours without touching any of
         them, and means a theme change moves the whole window at once.

         The library's surfaces are deliberately translucent, which is what lets
         the Mica material show through. A solid colour here would cancel that.

         What stays GunWall's own is below: the status colours a firewall
         actually decides with, and the chart series. Those carry meaning rather
         than surface, and the library has no opinion about them. -->

    <!-- Surfaces, aliased to the library -->
    <SolidColorBrush x:Key="BgPrimary" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="BgSecondary" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="BgCard" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="BgElevated" Color="{DynamicResource SolidBackgroundFillColorTertiary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="Divider" Color="{DynamicResource DividerStrokeColorDefault}" />

    <!-- Interaction states -->
    <SolidColorBrush x:Key="SurfaceHover" Color="{DynamicResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="SurfacePressed" Color="{DynamicResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="{DynamicResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="FocusRing" Color="{DynamicResource SystemAccentColorSecondary}" />

    <!-- Type -->
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{DynamicResource TextFillColorTertiary}" />
    <SolidColorBrush x:Key="TextOnAccent" Color="{DynamicResource TextOnAccentFillColorPrimary}" />

    <!-- ===== GunWall's own, because they carry meaning =====
         A verdict colour is not a surface: "allowed" and "blocked" have to mean
         the same thing in either theme, and no control library can decide that. -->
    <SolidColorBrush x:Key="AllowFill" Color="#1E3325" />
    <SolidColorBrush x:Key="AllowText" Color="#6CCB5F" />
    <SolidColorBrush x:Key="BlockFill" Color="#3A2226" />
    <SolidColorBrush x:Key="BlockText" Color="#FF7B72" />
    <SolidColorBrush x:Key="WarnFill"  Color="#3A2F1C" />
    <SolidColorBrush x:Key="WarnText"  Color="#F2B23C" />
    <SolidColorBrush x:Key="InfoFill"  Color="#22314F" />
    <SolidColorBrush x:Key="InfoText"  Color="#6FA8FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#22331F" />

    <!-- Charts and the world map -->
    <SolidColorBrush x:Key="GraphCursor"   Color="#66FFFFFF" />
    <SolidColorBrush x:Key="SelectionFill" Color="#385B8DEF" />
    <SolidColorBrush x:Key="MapLand"       Color="#8E9BC4" />
    <SolidColorBrush x:Key="MapBorder"     Color="#4A5578" />

    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">True</sys:Boolean>
</ResourceDictionary>
