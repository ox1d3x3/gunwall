<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== DARK THEME =====
         Token names and values from handoff/SPEC.md section 2. The two themes
         are written out separately on the design's own instruction: light is not
         an inversion of dark, because the accent darkens and the status hues
         darken hard - the saturated dark-mode green and amber fail on white.

         One accent. Red is the only hue used decoratively; green and amber are
         STATE and never decoration, so a screen with nothing allowed, blocked
         or warning is red-and-ink only. Red doing double duty as both the primary
         action and "blocked" is the design's decision, not an oversight - in a
         firewall the destructive action and the blocked verdict are the same
         idea.

         The GunWall names on the left are kept so the existing markup resolves;
         the design token name is given beside each.
         ==================================================================== -->

    <SolidColorBrush x:Key="BgPrimary" Color="#0A0B0D" />        <!-- 'bg': window ground -->
    <SolidColorBrush x:Key="BgContent" Color="#0A0B0D" />      <!-- content sits on 'bg'; hairlines separate, not surfaces -->
    <SolidColorBrush x:Key="BgSecondary" Color="#0A0B0D" />    <!-- sidebar shares 'bg', divided by 'line' -->
    <SolidColorBrush x:Key="BgCard" Color="#101215" />         <!-- 'panel': chart card, inspector, posture, inputs -->
    <SolidColorBrush x:Key="BgElevated" Color="#171A1E" />     <!-- 'panel2': overlays, fields inside a panel -->
    <SolidColorBrush x:Key="Divider" Color="#17191D" />        <!-- 'line': row rules, chrome dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#26292F" />    <!-- 'line2': control borders, header rule -->
    <SolidColorBrush x:Key="SurfaceHover" Color="#0DFFFFFF" />   <!-- 'hover': 5% white -->
    <SolidColorBrush x:Key="RowHover" Color="#08FFFFFF" />       <!-- 'row-hover': 3% white, half 'hover' -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F6F7" />     <!-- 't1' -->
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA1AB" />   <!-- 't2' -->
    <SolidColorBrush x:Key="TextTertiary" Color="#646B75" />    <!-- 't3': metadata only; never load-bearing -->
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />    <!-- 'on-brand' -->
    <SolidColorBrush x:Key="FocusRing" Color="#FF3B21" />
    <SolidColorBrush x:Key="AllowText" Color="#35D07F" />       <!-- 'ok' -->
    <SolidColorBrush x:Key="AllowFill" Color="#2135D07F" />     <!-- 'ok-bg' -->
    <SolidColorBrush x:Key="BlockText" Color="#FF3B21" />       <!-- 'brand' -->
    <SolidColorBrush x:Key="BlockFill" Color="#24FF3B21" />     <!-- 'brand-bg' -->
    <SolidColorBrush x:Key="BrandHi" Color="#FF6A55" />         <!-- 'brand-hi': link hover ONLY -->
    <SolidColorBrush x:Key="WarnText" Color="#FFB020" />        <!-- 'warn' -->
    <SolidColorBrush x:Key="WarnFill" Color="#21FFB020" />      <!-- 'warn-bg' -->
    <SolidColorBrush x:Key="InfoText" Color="#646B75" />        <!-- neutral pill uses 't3' -->
    <SolidColorBrush x:Key="InfoFill" Color="#0FFFFFFF" />      <!-- 'neutral-bg' -->
    <SolidColorBrush x:Key="AccentSoft" Color="#24FF3B21" />
    <SolidColorBrush x:Key="GraphCursor" Color="#66F5F6F7" />
    <SolidColorBrush x:Key="SelectionFill" Color="#24FF3B21" />
    <SolidColorBrush x:Key="MapLand" Color="#171A1E" />
    <SolidColorBrush x:Key="MapBorder" Color="#26292F" />

    <!-- Chart series, SPEC.md section 9: download is the brand, upload is the
         TEXT colour - which is why these live here and not in the shared
         dictionary. Upload near-white is correct on a dark card and invisible
         on a light one. -->
    <SolidColorBrush x:Key="InboundBrush" Color="#FF3B21" />
    <SolidColorBrush x:Key="OutboundBrush" Color="#F5F6F7" />

    <!-- The area beneath each series, section 9. Same argument as the strokes
         above: these are tints OF the stroke colour, so they invert with it and
         belong in the palette rather than the shared dictionary. -->
    <SolidColorBrush x:Key="FillDown" Color="#1AFF3B21" />      <!-- 'fill-down': brand at 10% -->
    <SolidColorBrush x:Key="FillUp" Color="#12F5F6F7" />        <!-- 'fill-up': t1 at 7% -->

    <!-- Loading bars, section 10. Consumed by the table lifecycle states. -->
    <SolidColorBrush x:Key="Skeleton" Color="#0FFFFFFF" />      <!-- 'skeleton': 6% white -->

    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">True</sys:Boolean>
</ResourceDictionary>
