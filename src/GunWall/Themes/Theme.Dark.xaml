<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== DARK THEME =====
         These are the control library's own values, copied rather than
         referenced. An earlier version pointed each one at the library's colour
         with a DynamicResource, which is tidier on paper and does not survive a
         theme change: swapping this file replaces the brushes, and the library
         swaps its dictionary at the same moment, so the two arrived out of step
         and the window ended up with light surfaces under white text. Concrete
         values give exactly the same appearance and cannot desynchronise.

         If the library's palette changes upstream, these are the thirteen keys
         to re-copy - they are listed in its Resources/Theme/Dark.xaml and
         Light.xaml. -->

    <!-- Surfaces, matching the library's own -->
    <SolidColorBrush x:Key="BgPrimary" Color="#FF202020" />
    <SolidColorBrush x:Key="BgSecondary" Color="#1C1C1C" />
    <SolidColorBrush x:Key="BgCard" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="BgElevated" Color="#282828" />
    <SolidColorBrush x:Key="BorderBrush" Color="#19000000" />
    <SolidColorBrush x:Key="Divider" Color="#15FFFFFF" />

    <!-- Interaction states -->
    <SolidColorBrush x:Key="SurfaceHover" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="SurfacePressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="FocusRing" Color="#4C97EE" />

    <!-- Type -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#000000" />

    <!-- ===== GunWall's own, because they carry meaning =====
         A verdict colour is not a surface: "allowed" and "blocked" have to mean
         the same thing in either theme, and no control library can decide that. -->
    <SolidColorBrush x:Key="AllowFill" Color="#1E3325" />
    <SolidColorBrush x:Key="AllowText" Color="#6CCB5F" />
    <SolidColorBrush x:Key="BlockFill" Color="#3A2226" />
    <SolidColorBrush x:Key="BlockText" Color="#FF7B72" />
    <SolidColorBrush x:Key="WarnFill"  Color="#3A2F1C" />
    <SolidColorBrush x:Key="WarnText"  Color="#F2B23C" />
    <SolidColorBrush x:Key="InfoFill"  Color="#22314F" />
    <SolidColorBrush x:Key="InfoText"  Color="#6FA8FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#22331F" />

    <!-- Charts and the world map -->
    <SolidColorBrush x:Key="GraphCursor"   Color="#66FFFFFF" />
    <SolidColorBrush x:Key="SelectionFill" Color="#385B8DEF" />
    <SolidColorBrush x:Key="MapLand"       Color="#8E9BC4" />
    <SolidColorBrush x:Key="MapBorder"     Color="#4A5578" />

    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkTheme">True</sys:Boolean>
</ResourceDictionary>
