<Application
    x:Class="GunWall.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF UI (lepoco/wpfui, MIT) supplies the Fluent control set.
                     Merged FIRST so GunWall's dictionaries below can override
                     what they need to: last writer wins for a given key.

                     The palette here is a starting point only. At runtime the
                     library derives the full theme - including the fourteen or
                     so accent resources it computes from a single seed colour -
                     which is why nothing restates those keys by hand any more.
                     See ApplyControlLibraryTheme in MainWindow. -->
                <ui:ThemesDictionary Theme="Dark" />

                <ui:ControlsDictionary />

                <!-- GunWall's palette (dark by default), swapped at runtime. -->
                <ResourceDictionary Source="Themes/Theme.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <!-- Icon geometry. After Controls.xaml because NavIcon references
                     palette brushes, and merged into the shared set rather than
                     either palette because geometry does not invert with theme -
                     only the ink flowing through it does. -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
